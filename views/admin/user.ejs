<%- include("../partials/adminHeader") %>
    <div class="mb-8">
        <h2 class="text-4xl font-display font-bold text-slate-900 dark:text-white mb-2">User Management</h2>
        <p class="text-slate-500 dark:text-slate-400">Manage user account statuses and permissions.</p>
    </div>
    <div
        class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div
            class="p-6 border-b border-slate-200 dark:border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="relative flex-1 max-w-md">
                <span
                    class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">search</span>

                <input id="userSearch"
                    class="w-full pl-10 pr-10 py-2 bg-slate-50 dark:bg-slate-800 border-none focus:ring-2 focus:ring-primary/20 rounded-xl text-sm transition-all"
                    placeholder="Search by name, email or username..." type="text" value="<%= searchQuery %>" />

                <button id="clearSearchBtn" onclick="clearSearch()"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 flex items-center justify-center p-1 <%= searchQuery ? '' : 'hidden' %>">
                    <span class="material-icons-outlined text-sm">close</span>
                </button>
            </div>
            <div class="flex items-center space-x-4">
                <select id="statusFilter"
                    class="bg-slate-50 dark:bg-slate-800 border-none text-sm rounded-xl py-2 pl-4 pr-10 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                    <option value="all">All Status</option>
                    <option value="active" <%=currentStatus==='active' ? 'selected' : '' %>>Active</option>
                    <option value="suspended" <%=currentStatus==='suspended' ? 'selected' : '' %>>Suspended</option>
                </select>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr
                        class="text-[11px] uppercase tracking-wider text-slate-500 dark:text-slate-400 font-bold bg-slate-50 dark:bg-slate-800/50">
                        <th class="px-6 py-4">User</th>
                        <th class="px-6 py-4">Username</th>
                        <th class="px-6 py-4">Email Address</th>
                        <th class="px-6 py-4">Phone Number</th>
                        <th class="px-6 py-4">Referral Code</th>
                        <th class="px-6 py-4 text-right">Account Control</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    <% users.forEach(user=> { %>
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-3">
                                    <div
                                        class="w-9 h-9 rounded-full bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center">
                                        <span class="text-xs font-bold text-primary">
                                            <%= user.firstName.charAt(0) %>
                                                <%= user.lastName ? user.lastName.charAt(0) : '' %>
                                        </span>
                                    </div>
                                    <div class="font-medium text-slate-900 dark:text-white">
                                        <%= user.firstName %>
                                            <%= user.lastName %>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-500">@<%= user.userName %>
                            </td>
                            <td class="px-6 py-4 text-sm">
                                <%= user.email %>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-500 dark:text-slate-400">
                                <%= user.phone %>
                            </td>
                            <td class="px-6 py-4 text-sm font-mono text-slate-500 dark:text-slate-400">
                                <%= user.referralCode %>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end space-x-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                    <%= user.status === 'active' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' %>">
                                        <%= user.status==='active' ? 'Active' : 'Suspended' %>
                                    </span>
                                    <button onclick="updateStatus('<%= user._id %>')"
                                        class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors 
                        <%= user.status === 'active' ? 'border border-red-200 text-red-600 hover:bg-red-50' : 'bg-primary text-white hover:bg-pink-600' %>">
                                        <%= user.status==='active' ? 'Block User' : 'Unblock User' %>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
        <div class="p-6 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <p class="text-sm text-slate-500 dark:text-slate-400">
                Showing <span class="font-medium">
                    <%= (currentPage - 1) * limit + 1 %>
                </span> to
                <span class="font-medium">
                    <%= Math.min(currentPage * limit, totalUsers) %>
                </span> of
                <span class="font-medium">
                    <%= totalUsers %>
                </span> results
            </p>

            <div class="flex items-center space-x-1">
                <% if (currentPage> 1) { %>
                    <a href="?page=<%= currentPage - 1 %>&status=<%= currentStatus %>&search=<%= searchQuery %>"
                        class="px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-lg text-sm hover:bg-slate-50 transition-colors">Previous</a>
                    <% } %>

                        <% for(let i=1; i <=totalPages; i++) { %>
                            <a href="?page=<%= i %>&status=<%= currentStatus %>&search=<%= searchQuery %>"
                                class="px-3.5 py-1.5 text-sm rounded-lg transition-colors <%= i === currentPage ? 'bg-primary text-white font-medium shadow-sm' : 'hover:bg-slate-100' %>">
                                <%= i %>
                            </a>
                            <% } %>

                                <% if (currentPage < totalPages) { %>
                                    <a href="?page=<%= currentPage + 1 %>&status=<%= currentStatus %>&search=<%= searchQuery %>"
                                        class="px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-lg text-sm hover:bg-slate-50 transition-colors">Next</a>
                                    <% } %>
            </div>
        </div>
    </div>

    <%- include("../partials/adminFooter") %>
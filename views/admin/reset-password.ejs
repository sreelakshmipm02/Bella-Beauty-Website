<!DOCTYPE html>
<html lang="en">
<head>
    <title>Reset Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="bg-white p-8 rounded-xl shadow-md max-w-md w-full">
        <h2 class="text-2xl font-bold text-center text-pink-600 mb-6">Set New Password</h2>

        <% if (error) { %>
            <div class="bg-red-100 text-red-700 p-3 rounded mb-4 text-sm"><%= error %></div>
        <% } %>

        <form action="/admin/reset-password/<%= token %>" method="POST" class="space-y-4" id="adminResetForm" novalidate>
            <div>
                <label class="block text-sm font-medium text-gray-700">New Password</label>
                <input type="password" name="password" id="adminResetPassword" placeholder="Minimum 8 characters"
                    class="w-full mt-1 p-3 border border-gray-300 rounded-lg focus:ring-pink-500 focus:border-pink-500">
                <p id="adminResetPasswordError" class="text-red-500 text-xs mt-1 hidden"></p>
            </div>
            <button type="submit" 
                class="w-full bg-pink-600 text-white py-3 rounded-lg font-bold hover:bg-pink-700 transition">
                Reset Password
            </button>
        </form>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('adminResetForm');
            const passwordInput = document.getElementById('adminResetPassword');
            const errorEl = document.getElementById('adminResetPasswordError');
            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{8,}$/;

            function validatePassword() {
                const value = passwordInput.value;

                if (!value) {
                    errorEl.textContent = 'Password is required';
                    errorEl.classList.remove('hidden');
                    passwordInput.classList.add('border-red-500');
                    return false;
                }

                if (!passwordRegex.test(value)) {
                    errorEl.textContent = 'Use 8+ characters with uppercase, lowercase, number, and symbol.';
                    errorEl.classList.remove('hidden');
                    passwordInput.classList.add('border-red-500');
                    return false;
                }

                errorEl.classList.add('hidden');
                passwordInput.classList.remove('border-red-500');
                return true;
            }

            form.addEventListener('submit', (event) => {
                if (!validatePassword()) {
                    event.preventDefault();
                }
            });

            passwordInput.addEventListener('input', validatePassword);
        });
    </script>
</body>
</html>

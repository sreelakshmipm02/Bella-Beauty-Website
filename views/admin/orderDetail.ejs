<%- include("../partials/adminHeader") %>

<%
    const isFailedOrder = order.payment && order.payment.status === 'Failed';
    const displayOrderStatus = isFailedOrder ? 'Order Not Placed' : (order.orderStatus || 'Pending');
%>

<main class="p-6 sm:p-10 space-y-6 max-w-7xl mx-auto">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div>
            <div class="flex items-center gap-3 mb-1">
                <a href="/admin/orders" class="w-8 h-8 flex items-center justify-center rounded-lg bg-gray-50 text-gray-500 hover:bg-primary hover:text-white transition">
                    <span class="material-icons-outlined text-sm">arrow_back</span>
                </a>
                <h1 class="text-2xl font-bold text-gray-900 font-display">Order: <%= order.orderId %></h1>
            </div>
            <p class="text-sm text-gray-500 ml-11">
                <%= isFailedOrder ? 'Payment failed on' : 'Placed on' %> <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute:'2-digit' }) %>
            </p>
        </div>

        <div class="flex items-center gap-3 ml-11 md:ml-0 bg-gray-50 p-2 rounded-xl border border-gray-100">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider pl-2">Master Status:</span>
            <% if (isFailedOrder) { %>
                <span class="text-sm font-bold px-4 py-2 rounded-lg border-2 bg-red-50 text-red-700 border-red-200 shadow-sm">
                    <%= displayOrderStatus %>
                </span>
            <% } else { %>
                <select onchange="updateOrderStatus('<%= order._id %>', this.value)"
            class="text-sm font-bold px-4 py-2 rounded-lg border-2 outline-none cursor-pointer shadow-sm transition
            <%= order.orderStatus === 'Pending' ? 'bg-yellow-50 text-yellow-700 border-yellow-200' : '' %>
            <%= order.orderStatus === 'Delivered' ? 'bg-green-50 text-green-700 border-green-200' : '' %>
            <%= order.orderStatus.includes('Return') ? 'bg-orange-50 text-orange-700 border-orange-200' : '' %>
            <%= (order.orderStatus === 'Cancelled' || order.orderStatus === 'Returned') ? 'bg-red-50 text-red-700 border-red-200' : 'bg-blue-50 text-blue-700 border-blue-200' %>"
            <%= (order.orderStatus === 'Return Requested' || order.orderStatus === 'Return Approved' || order.orderStatus === 'Cancelled' || order.orderStatus === 'Returned') ? 'disabled' : '' %>>
        
        <% 
            const flow = ['Pending', 'Processing', 'Shipped', 'Delivered'];
            const currentIdx = flow.indexOf(order.orderStatus);
            const isReturnFlow = order.orderStatus.includes('Return'); 
        %>

        <% flow.forEach((step, index) => { %>
            <option value="<%= step %>" 
                <%= order.orderStatus === step ? 'selected' : '' %>
                <%= (index < currentIdx || isReturnFlow) ? 'disabled' : '' %>>
                <%= step %>
            </option>
        <% }) %>

        <% if (order.orderStatus === 'Return Requested') { %>
            <option value="Return Requested" selected disabled>Return Requested (Check items below)</option>
        <% } %>

        <% if (order.orderStatus === 'Return Approved') { %>
            <option value="Return Approved" selected disabled>Return Approved (Legacy Status)</option>
        <% } %>

        <% if (order.orderStatus === 'Returned') { %>
            <option value="Returned" selected disabled>Returned</option>
        <% } %>
        
        <option value="Cancelled" <%= order.orderStatus === 'Cancelled' ? 'selected' : '' %> 
            <%= (currentIdx > 0 || isReturnFlow) ? 'disabled' : '' %>>Cancelled</option>

    </select>
            <% } %>
        </div>
    </div>

    <% if (isFailedOrder) { %>
        <div class="bg-red-50 rounded-2xl border border-red-200 shadow-sm p-5 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center shrink-0">
                <span class="material-icons-outlined text-red-600">block</span>
            </div>
            <div>
                <h2 class="text-sm font-bold text-red-800 uppercase tracking-wider mb-1">Order Not Placed</h2>
                <p class="text-sm text-red-700">This payment failed, so the order was not placed and cannot move through the normal fulfillment flow.</p>
            </div>
        </div>
    <% } %>

    <div class="flex flex-col lg:flex-row gap-6">
        
        <div class="flex-1 space-y-6">
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-6 border-b border-gray-100 pb-4">Purchased Items (<%= order.items.length %>)</h2>
                
                <div class="space-y-6">
                    <% order.items.forEach(item => { %>
                        <div class="flex flex-col sm:flex-row gap-5 border-b border-gray-50 pb-6 last:border-0 last:pb-0">
                            <div class="w-24 h-24 rounded-xl bg-gray-50 border border-gray-100 overflow-hidden shrink-0">
                                <img src="<%= item.image %>" class="w-full h-full object-cover">
                            </div>
                            
                            <div class="flex-1">
                                <h3 class="font-bold text-gray-900 text-base mb-1 line-clamp-2"><%= item.productName %></h3>
                                <p class="text-sm text-gray-500 mb-3">Price: ₹<%= item.price %> | Qty: <%= item.quantity %></p>
                                
                                <% 
                                    let itemStatus = isFailedOrder ? 'Order Not Placed' : (item.status || 'Pending');
                                    let itemStatusColor = 'text-yellow-700 bg-yellow-100 border-yellow-300';
                                    if (itemStatus === 'Order Not Placed') itemStatusColor = 'text-red-700 bg-red-100 border-red-300';
                                    if (itemStatus === 'Delivered') itemStatusColor = 'text-green-700 bg-green-100 border-green-300';
                                    if (itemStatus === 'Cancelled' || itemStatus === 'Returned') itemStatusColor = 'text-red-700 bg-red-100 border-red-300';
                                    if (itemStatus === 'Shipped' || itemStatus === 'Processing') itemStatusColor = 'text-blue-700 bg-blue-100 border-blue-300';
                                    if (itemStatus === 'Return Requested') itemStatusColor = 'text-orange-700 bg-orange-100 border-orange-300';
                                    if (itemStatus === 'Return Approved') itemStatusColor = 'text-teal-700 bg-teal-100 border-teal-300';
                                    if (itemStatus === 'Return Rejected') itemStatusColor = 'text-gray-700 bg-gray-200 border-gray-400';
                                %>
                                <div class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-[11px] font-bold uppercase tracking-wider border <%= itemStatusColor %> w-max">
                                    <%= itemStatus %>
                                </div>
                                
                                <% if (item.status === 'Return Rejected' && item.adminRejectReason) { %>
                                    <div class="mt-3 bg-red-50 p-3 rounded-lg border border-red-100">
                                        <p class="text-xs text-red-600"><span class="font-bold uppercase tracking-wider text-[10px]">Your Rejection Reason:</span> <br><%= item.adminRejectReason %></p>
                                    </div>
                                <% } %>

                                <% if (item.refund && item.refund.status === 'Pending') { %>
                                    <div class="mt-3 bg-amber-50 p-3 rounded-lg border border-amber-100">
                                        <p class="text-xs text-amber-700"><span class="font-bold uppercase tracking-wider text-[10px]">Wallet Refund:</span> <br>Pending admin approval.</p>
                                    </div>
                                <% } %>

                                <% if (item.refund && item.refund.status === 'Processed' && item.refund.amount > 0) { %>
                                    <div class="mt-3 bg-emerald-50 p-3 rounded-lg border border-emerald-100">
                                        <p class="text-xs text-emerald-700">
                                            <span class="font-bold uppercase tracking-wider text-[10px]">Wallet Refunded:</span>
                                            <br>₹<%= item.refund.amount.toFixed(2) %> credited
                                            <% if (item.refund.transactionReference) { %>
                                                <br>Ref: <%= item.refund.transactionReference %>
                                            <% } %>
                                        </p>
                                    </div>
                                <% } %>

                                <% if (item.status === 'Return Requested') { %>
                                    <div class="mt-3 flex gap-2">
                                        <button onclick="processReturn('<%= order._id %>', '<%= item._id %>', 'Approve')" class="bg-green-100 text-green-700 border border-green-200 px-4 py-1.5 rounded-lg text-xs font-bold hover:bg-green-200 transition flex items-center gap-1 shadow-sm">
                                            <span class="material-icons-outlined text-[14px]">check_circle</span> Approve Return
                                        </button>
                                        <button onclick="processReturn('<%= order._id %>', '<%= item._id %>', 'Reject')" class="bg-red-100 text-red-700 border border-red-200 px-4 py-1.5 rounded-lg text-xs font-bold hover:bg-red-200 transition flex items-center gap-1 shadow-sm">
                                            <span class="material-icons-outlined text-[14px]">cancel</span> Reject Return
                                        </button>
                                    </div>
                                <% } %>

                                <% if (item.cancelReason) { %>
                                    <div class="mt-3 bg-red-50 p-3 rounded-lg border border-red-100">
                                        <p class="text-xs text-red-600"><span class="font-bold uppercase tracking-wider text-[10px]">Reason for <%= item.status %>:</span> <br><%= item.cancelReason %></p>
                                    </div>
                                <% } %>
                            </div>
                            
                            <div class="text-left sm:text-right flex flex-col justify-center">
                                <p class="text-xs text-gray-400 mb-1">Item Total</p>
                                <p class="font-bold text-xl text-gray-900">₹<%= item.itemTotal.toFixed(2) %></p>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <% if (order.cancelReason || order.returnReason) { %>
                <div class="bg-red-50 rounded-2xl border border-red-200 shadow-sm p-6 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center shrink-0">
                        <span class="material-icons-outlined text-red-600">info</span>
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-red-800 uppercase tracking-wider mb-1">
                            Master <%= order.cancelReason ? 'Cancellation' : 'Return' %> Reason
                        </h2>
                        <p class="text-sm text-red-700"><%= order.cancelReason || order.returnReason %></p>
                    </div>
                </div>
            <% } %>
        </div>

        <div class="w-full lg:w-1/3 space-y-6">
            
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 border-b border-gray-100 pb-3">Customer Details</h3>
                <% const customerName = order.userId && (order.userId.firstName || order.userId.lastName)
                    ? `${order.userId.firstName || ''} ${order.userId.lastName || ''}`.trim()
                    : order.shippingAddress.fullName; %>
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-xl">
                        <%= customerName.charAt(0).toUpperCase() %>
                    </div>
                    <div>
                        <p class="font-bold text-gray-900"><%= customerName %></p>
                        <p class="text-sm text-gray-500"><%= (order.userId && order.userId.email) ? order.userId.email : 'No email provided' %></p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 border-b border-gray-100 pb-3">Shipping Address</h3>
                <div class="space-y-1">
                    <p class="font-bold text-gray-900"><%= order.shippingAddress.fullName %></p>
                    <p class="text-sm text-gray-600"><%= order.shippingAddress.addressLine1 %></p>
                    <% if (order.shippingAddress.addressLine2) { %>
                        <p class="text-sm text-gray-600"><%= order.shippingAddress.addressLine2 %></p>
                    <% } %>
                    <p class="text-sm text-gray-600"><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.postalCode %></p>
                </div>
                <div class="mt-4 pt-4 border-t border-gray-50 flex items-center gap-2">
                    <span class="material-icons-outlined text-gray-400 text-sm">phone</span>
                    <p class="text-sm text-gray-700 font-medium"><%= order.shippingAddress.phone %></p>
                </div>
            </div>

            <div class="bg-gray-50 rounded-2xl border border-gray-200 shadow-sm p-6">
                <div class="flex justify-between items-center mb-6 pb-6 border-b border-gray-200">
                    <div>
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Payment Method</h3>
                        <p class="font-bold text-gray-900"><%= order.payment.method === 'Wallet' ? 'Bella Wallet' : order.payment.method %></p>
                        <% if (order.payment.transactionId) { %>
                            <p class="text-xs text-gray-500 mt-1">Reference: <span class="font-medium text-gray-700"><%= order.payment.transactionId %></span></p>
                        <% } %>
                    </div>
                    
                    <select onchange="updatePaymentStatus('<%= order._id %>', this.value)"
                        class="text-[10px] font-bold px-3 py-1 rounded-md border outline-none cursor-pointer transition
                        <%= order.payment.status === 'Paid' ? 'bg-green-100 text-green-800 border-green-200' : '' %>
                        <%= order.payment.status === 'Failed' ? 'bg-red-100 text-red-800 border-red-200' : '' %>
                        <%= order.payment.status === 'Partially Refunded' ? 'bg-blue-100 text-blue-800 border-blue-200' : '' %>
                        <%= order.payment.status === 'Refunded' ? 'bg-emerald-100 text-emerald-800 border-emerald-200' : '' %>
                        <%= order.payment.status === 'Pending' ? 'bg-yellow-100 text-yellow-800 border-yellow-200' : '' %>"
                        <%= (['Refunded', 'Partially Refunded'].includes(order.payment.status) || isFailedOrder) ? 'disabled' : '' %>>
                        <option value="Pending" <%= order.payment.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="Paid" <%= order.payment.status === 'Paid' ? 'selected' : '' %>>Paid</option>
                        <option value="Failed" <%= order.payment.status === 'Failed' ? 'selected' : '' %>>Failed</option>
                        <option value="Partially Refunded" <%= order.payment.status === 'Partially Refunded' ? 'selected' : '' %>>Partially Refunded</option>
                        <option value="Refunded" <%= order.payment.status === 'Refunded' ? 'selected' : '' %>>Refunded</option>
                    </select>
                </div>

                <% if (order.payment.refundedAmount > 0) { %>
                    <div class="mb-6 rounded-xl bg-emerald-50 border border-emerald-100 p-4">
                        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Wallet Refund Summary</p>
                        <p class="text-sm font-semibold text-emerald-800">₹<%= order.payment.refundedAmount.toFixed(2) %> has been credited back to the user's wallet.</p>
                    </div>
                <% } %>

                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Price Summary</h3>
                <div class="space-y-3 text-sm text-gray-600 mb-4 pb-4 border-b border-gray-200">
                    <div class="flex justify-between">
                        <span>Subtotal</span>
                        <span class="font-medium text-gray-900">₹<%= order.summary.subtotal.toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between">
                        <span>Tax (GST)</span>
                        <span class="font-medium text-gray-900">₹<%= order.summary.tax.toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between text-green-600">
                        <span>Delivery</span>
                        <span class="font-medium">Free</span>
                    </div>
                    <% if (order.summary.discount > 0) { %>
                        <div class="flex justify-between text-green-600">
                            <span>Discount</span>
                            <span class="font-medium">- ₹<%= order.summary.discount.toFixed(2) %></span>
                        </div>
                    <% } %>
                    <% if (order.payment.method === 'Wallet') { %>
                        <div class="flex justify-between text-primary">
                            <span>Wallet Paid</span>
                            <span class="font-medium">₹<%= (order.payment.walletAmount || order.summary.total).toFixed(2) %></span>
                        </div>
                    <% } %>
                </div>
                <div class="flex justify-between items-end">
                    <span class="font-bold text-gray-900">Total</span>
                    <span class="text-2xl font-bold text-primary">₹<%= order.summary.total.toFixed(2) %></span>
                </div>
            </div>

        </div>
    </div>
</main>

<script>
    async function updateOrderStatus(orderId, newStatus) {
        let msg = `Updating to ${newStatus}. This action cannot be undone.`;

        const { isConfirmed } = await Swal.fire({
            title: 'Confirm Status Update',
            text: msg,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, update it!',
            confirmButtonColor: '#ec4899'
        });

        if (!isConfirmed) {
            window.location.reload();
            return;
        }

        try {
            const response = await fetch(`/admin/orders/${orderId}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            });
            const data = await response.json();

            if (data.success) {
                Swal.fire({ icon: 'success', title: 'Updated!', text: data.message, showConfirmButton: false, timer: 1500 });
                setTimeout(() => window.location.reload(), 1500);
            } else {
                Swal.fire('Error', data.message, 'error');
                window.location.reload();
            }
        } catch (error) {
            Swal.fire('Error', 'Network Error', 'error');
            window.location.reload();
        }
    }

    async function updatePaymentStatus(orderId, newStatus) {
        const { isConfirmed } = await Swal.fire({
            title: 'Update Payment Status?',
            text: `Are you sure you want to mark this as ${newStatus}?`,
            icon: 'info',
            showCancelButton: true,
            confirmButtonText: 'Yes, update it!',
            confirmButtonColor: '#ec4899'
        });

        if (!isConfirmed) {
            window.location.reload();
            return;
        }

        try {
            const response = await fetch(`/admin/orders/${orderId}/payment-status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            });
            const data = await response.json();

            if (data.success) {
                Swal.fire({ icon: 'success', title: 'Updated!', text: data.message, showConfirmButton: false, timer: 1500 });
                setTimeout(() => window.location.reload(), 1500);
            } else {
                Swal.fire('Error', data.message, 'error');
                window.location.reload();
            }
        } catch (error) {
            Swal.fire('Error', 'Network Error', 'error');
            window.location.reload();
        }
    }

    async function processReturn(orderId, itemId, action) {
        let rejectReason = '';

        if (action === 'Reject') {
            const { value, isConfirmed } = await Swal.fire({
                title: 'Reject Return?',
                html: `
                    <div class="mt-4 text-left">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Please provide a reason for rejecting this return (the user will see this):</label>
                        <textarea id="rejectReasonInput" class="w-full p-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-primary focus:border-primary transition text-sm" rows="4" placeholder="e.g., The 10-day return window has expired..."></textarea>
                        <p id="rejectReasonError" class="hidden text-xs text-red-500 mt-2"></p>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                confirmButtonText: 'Reject Return',
                didOpen: () => {
                    const input = document.getElementById('rejectReasonInput');
                    const error = document.getElementById('rejectReasonError');
                    input.addEventListener('input', () => {
                        input.classList.remove('border-red-500');
                        error.textContent = '';
                        error.classList.add('hidden');
                    });
                },
                preConfirm: () => {
                    const input = document.getElementById('rejectReasonInput');
                    const error = document.getElementById('rejectReasonError');
                    const trimmedValue = input.value.trim();

                    input.classList.remove('border-red-500');
                    error.textContent = '';
                    error.classList.add('hidden');

                    if (!trimmedValue) {
                        input.classList.add('border-red-500');
                        error.textContent = 'You must provide a reason.';
                        error.classList.remove('hidden');
                        return false;
                    }

                    if (trimmedValue.length < 10) {
                        input.classList.add('border-red-500');
                        error.textContent = 'Please provide a clear reason (at least 10 characters).';
                        error.classList.remove('hidden');
                        return false;
                    }

                    if (trimmedValue.length > 250) {
                        input.classList.add('border-red-500');
                        error.textContent = 'Reason is too long (maximum 250 characters).';
                        error.classList.remove('hidden');
                        return false;
                    }

                    return trimmedValue;
                }
            });
            if (!isConfirmed) return;
            rejectReason = value.trim().replace(/</g, "&lt;").replace(/>/g, "&gt;");
            
        } else {
            const { isConfirmed } = await Swal.fire({
                title: 'Approve Return Request?',
                text: "This will approve the return, restore stock immediately, and refund the amount to the user's wallet if the order was paid.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                confirmButtonText: 'Yes, Approve!'
            });
            if (!isConfirmed) return;
        }

        try {
            Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            
            const response = await fetch(`/admin/orders/${orderId}/items/${itemId}/process-return`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action, rejectReason })
            });
            const data = await response.json();
            
            if (data.success) {
                await Swal.fire({ icon: 'success', title: 'Done!', text: data.message, timer: 1500, showConfirmButton: false });
                window.location.reload();
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        } catch (error) {
            Swal.fire('Error', 'Network Error', 'error');
        }
    }
</script>

<%- include("../partials/adminFooter") %>

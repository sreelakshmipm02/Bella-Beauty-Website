<%- include("../partials/adminHeader") %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h2 class="text-3xl font-display font-bold text-slate-900 dark:text-white mb-1">Coupon Management</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm">Create, edit, search, and control coupon availability.</p>
    </div>

    <button
        type="button"
        onclick="openCouponModal()"
        class="inline-flex items-center justify-center px-5 py-2.5 bg-[#e83e8c] text-white font-medium text-sm rounded-lg hover:bg-pink-600 transition-colors shadow-sm">
        <span class="material-symbols-outlined mr-2 text-[18px]">add</span>
        Add Coupon
    </button>
</div>

<div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="relative flex-1 max-w-md">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
            <input
                id="couponSearch"
                type="text"
                value="<%= searchQuery || '' %>"
                class="w-full pl-10 pr-10 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:ring-2 focus:ring-[#e83e8c]/20 focus:border-[#e83e8c] rounded-lg text-sm transition-all outline-none"
                placeholder="Search by coupon code or description..." />

            <button
                id="clearSearchBtn"
                onclick="clearSearch()"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-[#e83e8c] flex items-center justify-center <%= searchQuery ? '' : 'hidden' %>">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-[11px] uppercase tracking-wider text-slate-400 dark:text-slate-500 font-semibold bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800">
                    <th class="px-6 py-4">Coupon Code</th>
                    <th class="px-6 py-4">Discount Type</th>
                    <th class="px-6 py-4">Discount Value</th>
                    <th class="px-6 py-4">Validity</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                <% if (coupons.length > 0) { %>
                    <% coupons.forEach((coupon) => { %>
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex flex-col gap-1">
                                    <span class="font-semibold text-slate-900 dark:text-white"><%= coupon.code %></span>
                                    <span class="text-xs text-slate-500 dark:text-slate-400">
                                        Usage limit: <%= coupon.usageLimit || "Unlimited" %>
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300 capitalize">
                                <%= coupon.discountType %>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">
                                <%= coupon.discountType === 'percentage' ? `${coupon.discountValue}%` : `₹${coupon.discountValue.toFixed(2)}` %>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">
                                <div class="flex flex-col gap-1">
                                    <span><%= coupon.expiresAt ? new Date(coupon.expiresAt).toLocaleDateString('en-IN') : 'No expiry' %></span>
                                    <span class="<%= coupon.isActive ? 'text-green-600' : 'text-slate-400' %> text-xs font-medium">
                                        <%= coupon.isActive ? 'Enabled' : 'Disabled' %>
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end space-x-4">
                                    <button
                                        type="button"
                                        onclick="openCouponModal('<%= coupon._id %>')"
                                        class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 transition-colors"
                                        title="Edit Coupon">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </button>
                                    <button
                                        type="button"
                                        onclick="toggleCouponStatus('<%= coupon._id %>')"
                                        class="<%= coupon.isActive ? 'text-green-500 hover:text-green-600' : 'text-slate-400 hover:text-slate-500' %> transition-colors"
                                        title="<%= coupon.isActive ? 'Disable Coupon' : 'Enable Coupon' %>">
                                        <span class="material-symbols-outlined text-[26px]">
                                            <%= coupon.isActive ? 'toggle_on' : 'toggle_off' %>
                                        </span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-500">No coupons found matching your search.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <% if (totalPages > 0) { %>
        <div class="p-4 md:p-5 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-sm text-slate-500 dark:text-slate-400">
                Showing
                <span class="font-medium"><%= (currentPage - 1) * limit + 1 %></span>
                to
                <span class="font-medium"><%= Math.min(currentPage * limit, totalCoupons) %></span>
                of
                <span class="font-medium"><%= totalCoupons %></span>
                coupons
            </p>

            <div class="flex items-center space-x-1">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %>&search=<%= searchQuery %>" class="flex items-center justify-center w-8 h-8 rounded border border-slate-200 text-slate-500 hover:bg-slate-50 transition-colors">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </a>
                <% } else { %>
                    <button disabled class="flex items-center justify-center w-8 h-8 rounded border border-slate-200 text-slate-300 cursor-not-allowed">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </button>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                    <a href="?page=<%= i %>&search=<%= searchQuery %>" class="flex items-center justify-center w-8 h-8 rounded text-sm transition-colors <%= i === currentPage ? 'bg-[#e83e8c] text-white font-medium border border-[#e83e8c]' : 'border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
                        <%= i %>
                    </a>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %>&search=<%= searchQuery %>" class="flex items-center justify-center w-8 h-8 rounded border border-slate-200 text-slate-500 hover:bg-slate-50 transition-colors">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </a>
                <% } else { %>
                    <button disabled class="flex items-center justify-center w-8 h-8 rounded border border-slate-200 text-slate-300 cursor-not-allowed">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </button>
                <% } %>
            </div>
        </div>
    <% } %>
</div>

<div id="couponModal" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-sm px-4 py-8 overflow-y-auto">
    <div class="min-h-full flex items-center justify-center">
        <div class="w-full max-w-2xl bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div>
                    <h3 id="couponModalTitle" class="text-xl font-semibold text-slate-900 dark:text-white">Add Coupon</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Configure the coupon details below.</p>
                </div>
                <button type="button" onclick="closeCouponModal()" class="text-slate-400 hover:text-slate-600">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form id="couponForm" class="p-6 space-y-5">
                <input type="hidden" id="couponId">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="couponCode" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Coupon Code</label>
                        <input id="couponCode" type="text"  class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm uppercase focus:border-primary focus:ring-primary">
                    </div>
                    <div>
                        <label for="couponExpiresAt" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Offer Validity</label>
                        <input id="couponExpiresAt" type="date"  class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm focus:border-primary focus:ring-primary">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="discountType" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Discount Type</label>
                        <select id="discountType"  class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm focus:border-primary focus:ring-primary">
                            <option value="fixed">Flat Discount</option>
                            <option value="percentage">Percentage Discount</option>
                        </select>
                    </div>
                    <div>
                        <label for="discountValue" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Discount Value</label>
                        <input id="discountValue" type="text" inputmode="decimal" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm focus:border-primary focus:ring-primary">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="minOrderAmount" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Minimum Purchase Value</label>
                        <input id="minOrderAmount" type="text" inputmode="decimal" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm focus:border-primary focus:ring-primary">
                    </div>
                    <div>
                        <label for="maxDiscount" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Maximum Discount Value</label>
                        <input id="maxDiscount" type="text" inputmode="decimal" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm focus:border-primary focus:ring-primary">
                    </div>
                </div>

                <div>
                    <label for="usageLimit" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Usage Limit</label>
                    <input id="usageLimit" type="text" inputmode="numeric" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm focus:border-primary focus:ring-primary">
                </div>

                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" onclick="closeCouponModal()" class="px-5 py-2.5 rounded-xl text-sm font-medium border border-slate-200 text-slate-600 hover:bg-slate-50 transition">
                        Cancel
                    </button>
                    <button id="saveCouponBtn" type="submit" class="px-5 py-2.5 rounded-xl text-sm font-semibold bg-[#e83e8c] text-white hover:bg-pink-600 transition">
                        Save Coupon
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const couponModal = document.getElementById('couponModal');
    const couponForm = document.getElementById('couponForm');
    const couponModalTitle = document.getElementById('couponModalTitle');
    const saveCouponBtn = document.getElementById('saveCouponBtn');

    function clearSearch() {
        window.location.href = '/admin/coupons';
    }

    document.getElementById('couponSearch').addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            const value = event.target.value.trim();
            const query = value ? `?search=${encodeURIComponent(value)}` : '';
            window.location.href = `/admin/coupons${query}`;
        }
    });

    function openCouponModal(couponId = '') {
        couponForm.reset();
        document.getElementById('couponId').value = '';
        couponModalTitle.innerText = couponId ? 'Edit Coupon' : 'Add Coupon';
        couponModal.classList.remove('hidden');

        if (!couponId) return;

        fetch(`/admin/coupons/${couponId}`)
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    throw new Error(data.message || 'Failed to load coupon');
                }

                const coupon = data.coupon;
                document.getElementById('couponId').value = coupon._id;
                document.getElementById('couponCode').value = coupon.code || '';
                document.getElementById('discountType').value = coupon.discountType || 'percentage';
                document.getElementById('discountValue').value = coupon.discountValue ?? '';
                document.getElementById('minOrderAmount').value = coupon.minOrderAmount ?? 0;
                document.getElementById('maxDiscount').value = coupon.maxDiscount ?? '';
                document.getElementById('usageLimit').value = coupon.usageLimit ?? '';
                document.getElementById('couponExpiresAt').value = coupon.expiresAt ? new Date(coupon.expiresAt).toISOString().split('T')[0] : '';
            })
            .catch(err => {
                closeCouponModal();
                Swal.fire('Error', err.message || 'Unable to load coupon details.', 'error');
            });
    }

    function closeCouponModal() {
        couponModal.classList.add('hidden');
    }

    couponForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        const couponId = document.getElementById('couponId').value;
        const payload = {
            code: document.getElementById('couponCode').value.trim(),
            discountType: document.getElementById('discountType').value,
            discountValue: document.getElementById('discountValue').value,
            minOrderAmount: document.getElementById('minOrderAmount').value,
            maxDiscount: document.getElementById('maxDiscount').value,
            expiresAt: document.getElementById('couponExpiresAt').value,
            usageLimit: document.getElementById('usageLimit').value
        };

        const today = new Date().toISOString().split('T')[0];
        const discountValue = Number(payload.discountValue);
        const minOrderAmount = Number(payload.minOrderAmount);
        const maxDiscount = Number(payload.maxDiscount);
        const usageLimit = Number(payload.usageLimit);

        if (!payload.code || !payload.discountType || !payload.discountValue || !payload.minOrderAmount || !payload.maxDiscount || !payload.expiresAt || !payload.usageLimit) {
            return Swal.fire('Missing Fields', 'Please fill in all coupon fields.', 'warning');
        }

        if (!/^[A-Z0-9_-]{3,20}$/.test(payload.code.toUpperCase())) {
            return Swal.fire('Invalid Coupon Code', 'Coupon code must be 3 to 20 characters and can contain letters, numbers, hyphens, or underscores.', 'warning');
        }

        if (Number.isNaN(discountValue) || discountValue <= 0) {
            return Swal.fire('Invalid Discount', 'Discount value must be greater than 0.', 'warning');
        }

        if (payload.discountType === 'percentage' && discountValue > 100) {
            return Swal.fire('Invalid Discount', 'Percentage discount cannot exceed 100.', 'warning');
        }

        if (Number.isNaN(minOrderAmount) || minOrderAmount < 0) {
            return Swal.fire('Invalid Minimum Purchase', 'Minimum purchase value must be 0 or greater.', 'warning');
        }

        if (Number.isNaN(maxDiscount) || maxDiscount <= 0) {
            return Swal.fire('Invalid Maximum Discount', 'Maximum discount value must be greater than 0.', 'warning');
        }

        if (maxDiscount > minOrderAmount && minOrderAmount > 0) {
            return Swal.fire('Invalid Maximum Discount', 'Maximum discount value cannot be greater than the minimum purchase value.', 'warning');
        }

        if (!payload.expiresAt || payload.expiresAt < today) {
            return Swal.fire('Invalid Validity', 'Offer validity must be today or a future date.', 'warning');
        }

        if (Number.isNaN(usageLimit) || usageLimit < 1 || !Number.isInteger(usageLimit)) {
            return Swal.fire('Invalid Usage Limit', 'Usage limit must be a whole number greater than or equal to 1.', 'warning');
        }

        const originalText = saveCouponBtn.innerText;
        saveCouponBtn.innerText = 'Saving...';
        saveCouponBtn.disabled = true;

        try {
            const response = await fetch(couponId ? `/admin/coupons/${couponId}` : '/admin/coupons', {
                method: couponId ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await response.json();

            if (!data.success) {
                throw new Error(data.message || 'Failed to save coupon');
            }

            await Swal.fire('Saved', data.message, 'success');
            window.location.reload();
        } catch (error) {
            Swal.fire('Error', error.message || 'Failed to save coupon.', 'error');
        } finally {
            saveCouponBtn.innerText = originalText;
            saveCouponBtn.disabled = false;
        }
    });

    async function toggleCouponStatus(couponId) {
        try {
            const response = await fetch(`/admin/coupons/${couponId}/status`, { method: 'PATCH' });
            const data = await response.json();

            if (!data.success) {
                throw new Error(data.message || 'Failed to update coupon status');
            }

            await Swal.fire('Updated', data.message, 'success');
            window.location.reload();
        } catch (error) {
            Swal.fire('Error', error.message || 'Failed to update coupon status.', 'error');
        }
    }
</script>

<%- include("../partials/adminFooter") %>

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Admin Forgot Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="bg-white p-8 rounded-xl shadow-md max-w-md w-full">
        <h2 class="text-2xl font-bold text-center text-pink-600 mb-6">Forgot Password</h2>
        
        <% if (error) { %>
            <div class="bg-red-100 text-red-700 p-3 rounded mb-4 text-sm"><%= error %></div>
        <% } %>
        <% if (message) { %>
            <div class="bg-green-100 text-green-700 p-3 rounded mb-4 text-sm"><%= message %></div>
        <% } %>

        <form action="/admin/forgot-password" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Enter Admin Email</label>
                <input type="email" name="email" required 
                    class="w-full mt-1 p-3 border border-gray-300 rounded-lg focus:ring-pink-500 focus:border-pink-500">
            </div>
            <button type="submit" 
                class="w-full bg-pink-600 text-white py-3 rounded-lg font-bold hover:bg-pink-700 transition">
                Send Reset Link
            </button>
        </form>
        <div class="mt-4 text-center">
            <a href="/admin/login" class="text-sm text-gray-500 hover:text-pink-600">Back to Login</a>
        </div>
    </div>
</body>
</html>
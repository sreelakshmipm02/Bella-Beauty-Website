<script>
    window.addEventListener('pageshow', function (event) {
        // If the page was loaded from the browser cache (Back/Forward button)
        if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
            // Force a reload to get fresh 'locals' data from the server
            window.location.reload();
        }
    });

    if (<%= locals.hasUserSession ? 'true' : 'false' %>) {
        const sessionHeartbeat = async () => {
            try {
                await fetch('/session/status', {
                    method: 'GET',
                    headers: { Accept: 'application/json' },
                    cache: 'no-store'
                });
            } catch (error) {
                console.error('Session heartbeat failed:', error);
            }
        };

        sessionHeartbeat();
        window.setInterval(sessionHeartbeat, 30000);
    }
</script>

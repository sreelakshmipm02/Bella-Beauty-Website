<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bella Admin - Dashboard Overview</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@700&family=Material+Icons+Outlined&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Icons+Outlined&display=swap" rel="stylesheet" />

    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
        rel="stylesheet" />

    <link rel="stylesheet" href="/css/style.css">
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#E91E63",
                        "background-light": "#F8F9FA",
                        "background-dark": "#111827",
                    },
                    fontFamily: {
                        display: ["Playfair Display", "serif"],
                        sans: ["Inter", "sans-serif"],
                    },
                    borderRadius: {
                        DEFAULT: "0.75rem",
                    },
                },
            },
        };
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .font-display {
            font-family: 'Playfair Display', serif;
        }

        .material-icons-outlined {
            font-size: 20px;
        }

        /* Sidebar active link styling */
        .sidebar-link.active {
            background-color: #E91E63;
            color: white !important;
        }
    </style>
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-200 min-h-screen flex flex-col">
    <header
        class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-6 py-4 flex justify-between items-center sticky top-0 z-30">
        <div class="flex items-center gap-4">
            <button id="mobile-menu-toggle"
                class="md:hidden p-2 text-slate-500 hover:bg-slate-100 rounded-lg transition-colors">
                <span class="material-icons-outlined">menu</span>
            </button>

            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-white">
                    <span class="material-icons-outlined">spa</span>
                </div>
                <h1 class="text-2xl font-display text-primary font-bold hidden sm:block">Bella Admin</h1>
            </div>

            <nav
                class="hidden lg:flex items-center gap-2 text-xs font-medium text-slate-400 ml-4 border-l border-slate-200 pl-4">
                <a href="/admin/dashboard" class="hover:text-primary transition-colors">Admin</a>
                <span class="material-icons-outlined !text-xs">chevron_right</span>
                <span id="breadcrumb-current" class="text-slate-600 dark:text-slate-300 capitalize">Dashboard</span>
            </nav>
        </div>

        <div class="flex items-center gap-6">
            <div class="relative group">
                <button onclick="toggleNotificationDropdown(event)"
                    class="relative p-2 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-all outline-none">
                    <span class="material-icons-outlined">notifications</span>

                    <% if (typeof lowStockCount !== 'undefined' && lowStockCount > 0) { %>
                        <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-red-500 border-2 border-white dark:border-slate-900 rounded-full animate-pulse"></span>
                    <% } %>
                </button>

                <div id="notification-dropdown"
                    class="hidden absolute right-0 mt-3 w-80 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl z-50 overflow-hidden">
                    <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center">
                        <h3 class="font-bold text-sm">Notifications</h3>
                        <% if (typeof lowStockCount !== 'undefined' && lowStockCount > 0) { %>
                            <span class="text-[10px] bg-red-100 text-red-600 px-2 py-0.5 rounded-full font-bold">Action Required</span>
                        <% } %>
                    </div>
                    
                    <div class="max-h-64 overflow-y-auto">
                        <% if (typeof lowStockCount !== 'undefined' && lowStockCount > 0) { %>
                            <a href="/admin/inventory?lowStock=true"
                                class="flex items-start gap-3 p-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                <div class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center text-red-600 shrink-0">
                                    <span class="material-icons-outlined text-sm">inventory</span>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-200">Critical Stock Alert</p>
                                    <p class="text-[11px] text-slate-500 mt-0.5">
                                        <%= lowStockCount %> Items are running low.
                                    </p>
                                    <p class="text-[10px] text-primary mt-1 font-bold underline">Restock Now</p>
                                </div>
                            </a>
                        <% } else { %>
                            <div class="p-8 text-center">
                                <span class="material-icons-outlined text-slate-300 text-3xl">notifications_none</span>
                                <p class="text-xs text-slate-500 mt-2 font-medium">No new notifications</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-pink-100 dark:bg-pink-900/30 text-primary flex items-center justify-center rounded-full font-bold">
                    AD
                </div>
                <span class="text-sm font-medium hidden sm:block">Admin User</span>
            </div>
        </div>
    </header>

    <div class="flex flex-1 overflow-hidden relative">
        <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-30 hidden transition-opacity"></div>

        <aside id="sidebar"
            class="fixed inset-y-0 left-0 z-40 w-72 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transform -translate-x-full md:relative md:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
            
            <nav class="flex-1 overflow-y-auto p-4 space-y-1">
                <a href="/admin/dashboard" class="sidebar-link group flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-800">
                    <span class="material-icons-outlined">dashboard</span>
                    <span class="font-medium">Dashboard</span>
                </a>

                <a href="/admin/orders" class="sidebar-link group flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-800">
                    <span class="material-icons-outlined">shopping_cart</span>
                    Order Management
                </a>
                <a href="/admin/category" class="sidebar-link group flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-800">
                    <span class="material-icons-outlined">category</span>
                    Category Management
                </a>
                <a href="/admin/products" class="sidebar-link group flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-800">
                    <span class="material-icons-outlined">inventory_2</span>
                    Product Management
                </a>
                <a href="/admin/inventory" class="sidebar-link group flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-800">
                    <span class="material-icons-outlined">inventory</span>
                    Stock Management
                </a>
                <a href="/admin/coupons" class="sidebar-link group flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-800">
                    <span class="material-icons-outlined">confirmation_number</span>
                    Coupon Management
                </a>
                <a href="/admin/offers" class="sidebar-link group flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-800">
                    <span class="material-icons-outlined">local_offer</span>
                    Offer Management
                </a>
                <a href="#" class="sidebar-link group flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-800">
                    <span class="material-icons-outlined">assignment_return</span>
                    Return & Refund
                </a>
                <a href="/admin/user" class="sidebar-link group flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-800">
                    <span class="material-icons-outlined">people</span>
                    User Management
                </a>
                <a href="#" class="sidebar-link group flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-800">
                    <span class="material-icons-outlined">payments</span>
                    Sales & Revenue
                </a>
            </nav>

            <script src="/js/logoutPopup.js"></script>
            <div class="p-4 border-t border-slate-200 dark:border-slate-800">
                <button onclick="confirmLogout('/admin/logout')"
                    class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-xl bg-red-500 hover:bg-red-600 text-white font-semibold transition shadow-lg shadow-red-500/20">
                    <span class="material-icons-outlined">logout</span>
                    Sign Out
                </button>
            </div>
        </aside>

        <main class="flex-1 overflow-y-auto p-8 relative">

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                // Handle Active Sidebar State
                const currentPath = window.location.pathname;
                const links = document.querySelectorAll(".sidebar-link");

                links.forEach(link => {
                    const linkPath = link.getAttribute("href");
                    if (currentPath === linkPath) {
                        link.classList.add("active");
                    }
                });

                // Mobile Menu Logic
                const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
                const sidebar = document.getElementById('sidebar');
                const overlay = document.getElementById('sidebar-overlay');

                if (mobileMenuToggle) {
                    mobileMenuToggle.addEventListener('click', () => {
                        sidebar.classList.remove('-translate-x-full');
                        overlay.classList.remove('hidden');
                    });
                }

                if (overlay) {
                    overlay.addEventListener('click', () => {
                        sidebar.classList.add('-translate-x-full');
                        overlay.classList.add('hidden');
                    });
                }
            });

            // Notification Dropdown Toggle
            function toggleNotificationDropdown(event) {
                event.stopPropagation();
                const dropdown = document.getElementById('notification-dropdown');
                dropdown.classList.toggle('hidden');

                // Close dropdown when clicking anywhere else
                const closeHandler = (e) => {
                    if (!dropdown.contains(e.target)) {
                        dropdown.classList.add('hidden');
                        document.removeEventListener('click', closeHandler);
                    }
                };
                document.addEventListener('click', closeHandler);
            }
        </script>

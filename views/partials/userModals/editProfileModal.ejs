<div id="editProfileModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog"
    aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">

        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"
            onclick="closeEditProfileModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <div
            class="inline-block align-bottom bg-white dark:bg-slate-900 rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full">

            <div class="px-6 py-6 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center">
                <h3 class="text-xl font-display font-bold text-slate-900 dark:text-white">Edit Profile</h3>
                <button onclick="closeEditProfileModal()" class="text-slate-400 hover:text-slate-500">
                    <span class="material-icons-outlined">close</span>
                </button>
            </div>

            <form id="editProfileForm" onsubmit="handleProfileUpdate(event)" enctype="multipart/form-data">
                <div class="px-6 py-6 space-y-6 max-h-[70vh] overflow-y-auto">

                    <div class="flex flex-col items-center gap-4">
                        <div class="relative group cursor-pointer w-24 h-24"
                            onclick="document.getElementById('profileImageInput').click()">
                            <img id="imagePreview" src="<%= user.profileImage || '/images/default-avatar.png' %>"
                                class="w-24 h-24 rounded-full object-cover border-4 border-slate-50 dark:border-slate-800 shadow-md group-hover:opacity-75 transition-opacity"
                                alt="Profile">

                            <div
                                class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                <span
                                    class="material-icons-outlined text-white bg-black/30 rounded-full p-2">photo_camera</span>
                            </div>
                        </div>
                        <input type="file" id="profileImageInput" name="profileImage" class="hidden" accept="image/*"
                            onchange="previewImage(this)">
                        <p class="text-xs text-slate-500">Tap to change profile picture</p>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">First
                                Name</label>
                            <input type="text" id="editFirstName" name="firstName" value="<%= user.firstName %>"
                                required
                                class="w-full rounded-xl border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:ring-primary focus:border-primary">
                            <p id="editFirstNameError" class="text-red-500 text-xs mt-1"></p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Last
                                Name</label>
                            <input type="text" id="editLastName" name="lastName" value="<%= user.lastName %>"
                                class="w-full rounded-xl border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:ring-primary focus:border-primary">
                            <p id="editLastNameError" class="text-red-500 text-xs mt-1"></p>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Mobile
                            Number</label>
                        <input type="tel" id="editPhone" name="phone" value="<%= user.phone %>"
                            class="w-full rounded-xl border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:ring-primary focus:border-primary">
                        <p id="editPhoneError" class="text-red-500 text-xs mt-1"></p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Email
                            Address</label>
                        <div class="relative">
                            <input type="email" id="editEmail" name="email" value="<%= user.email %>"
                                oninput="checkEmailChange('<%= user.email %>')"
                                class="w-full rounded-xl border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:ring-primary focus:border-primary pr-20">

                            <button type="button" id="verifyEmailBtn" onclick="sendUpdateOtp()" disabled
                                class="absolute right-2 top-1.5 px-3 py-1 text-xs font-bold text-white bg-slate-400 rounded-lg transition-colors disabled:cursor-not-allowed">
                                Verify
                            </button>
                        </div>
                        <p class="text-xs text-slate-400 mt-1">Verify button enables if you change email.</p>
                        <p id="editEmailError" class="text-red-500 text-xs mt-1"></p>
                    </div>

                </div>

                <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/50 flex flex-row-reverse gap-2">
                    <button type="submit" id="saveProfileBtn"
                        class="w-full sm:w-auto inline-flex justify-center rounded-xl border border-transparent shadow-sm px-4 py-2 bg-primary text-base font-medium text-white hover:bg-pink-600 focus:outline-none sm:text-sm">
                        Save Changes
                    </button>
                    <button type="button" onclick="closeEditProfileModal()"
                        class="mt-3 w-full sm:w-auto inline-flex justify-center rounded-xl border border-slate-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-slate-700 hover:bg-slate-50 sm:mt-0 sm:text-sm">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="updateEmailOtpModal"
    class="fixed inset-0 z-[60] hidden items-center justify-center p-4 bg-black/40 backdrop-blur-sm">
    <div class="bg-white dark:bg-card-dark rounded-3xl shadow-2xl p-8 text-center max-w-sm w-full relative">
        <button onclick="closeUpdateOtpModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
            <span class="material-icons-outlined">close</span>
        </button>

        <div class="mb-4">
            <div class="w-12 h-12 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-3">
                <span class="material-icons-outlined text-primary text-2xl">lock</span>
            </div>
            <h3 class="text-lg font-bold">Verify New Email</h3>
            <p class="text-xs text-slate-500">Enter the code sent to your new email.</p>
        </div>

        <div class="flex justify-center gap-2 mb-4">
            <input class="update-otp-input w-10 h-10 text-center border-2 rounded-lg" maxlength="1" />
            <input class="update-otp-input w-10 h-10 text-center border-2 rounded-lg" maxlength="1" />
            <input class="update-otp-input w-10 h-10 text-center border-2 rounded-lg" maxlength="1" />
            <input class="update-otp-input w-10 h-10 text-center border-2 rounded-lg" maxlength="1" />
        </div>

        <p id="updateOtpTimer" class="text-xs text-slate-500 mb-4">Expires in 60s</p>

        <button onclick="verifyEmailUpdate()"
            class="w-full bg-primary text-white py-2 rounded-xl font-bold text-sm">Verify & Update</button>
    </div>
</div>
<div id="loadingPopup" class="fixed inset-0 z-[150] hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-xl p-8 flex flex-col items-center gap-4">
        <div class="w-14 h-14 border-4 border-pink-200 border-t-primary rounded-full animate-spin"></div>
        <p class="text-slate-600 dark:text-slate-300 font-medium">
            Saving changes...
        </p>
    </div>
</div>
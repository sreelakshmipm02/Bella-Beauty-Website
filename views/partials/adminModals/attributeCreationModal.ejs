<div id="createAttributeModal" class="fixed inset-0 z-[60] hidden" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity opacity-0" id="createAttrBackdrop">
    </div>
    <div class="fixed inset-0 z-[70] w-screen overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
            <div id="createAttrPanel"
                class="relative transform overflow-hidden rounded-xl bg-white dark:bg-slate-900 text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">

                <div
                    class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                    <h3 class="text-xl font-bold text-slate-800 dark:text-white">Create New Attribute</h3>
                    <button type="button" onclick="closeCreateAttributeModal()"
                        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <div id="createAttrError"
                    class="hidden mx-6 mt-4 bg-red-50 border-l-4 border-red-500 p-4 text-red-700 text-sm rounded-md shadow-sm">
                    <p id="createAttrErrorText"></p>
                </div>

                <form id="createAttributeForm" onsubmit="submitNewAttribute(event)">
                    <div class="px-6 py-6 space-y-5">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Display
                                Label <span class="text-red-500">*</span></label>
                            <input type="text" id="attrDisplayLabel" name="displayLabel"
                                onkeyup="generateInternalAttrName()" required
                                class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-slate-50 dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-[#e83e8c]/30 focus:border-[#e83e8c] outline-none"
                                placeholder="e.g., Skin Type">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Internal
                                Name <span class="text-red-500">*</span></label>
                            <input type="text" id="attrInternalName" name="internalName" required
                                class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 outline-none"
                                placeholder="e.g., skin_type" readonly>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Data Type
                                <span class="text-red-500">*</span></label>
                            <select id="attrDataType" name="dataType" onchange="toggleAttrValuesInput()" required
                                class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-slate-50 dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-[#e83e8c]/30 focus:border-[#e83e8c] outline-none">
                                <option value="string">String (Text Input)</option>
                                <option value="number">Number</option>
                                <option value="enum">Dropdown (Single Select)</option>
                                <option value="array">Multiple Select (Checkboxes)</option>
                            </select>
                        </div>

                        <div id="attrValuesContainer" class="hidden">
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Possible
                                Values <span class="text-red-500">*</span></label>
                            <input type="text" id="attrPossibleValues" name="possibleValues"
                                class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-slate-50 dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-[#e83e8c]/30 focus:border-[#e83e8c] outline-none"
                                placeholder="e.g., Oily, Dry, Combination">
                            <p class="text-xs text-slate-500 mt-1">Separate values with commas.</p>
                        </div>
                    </div>

                    <div
                        class="bg-slate-50 dark:bg-slate-900 px-6 py-4 border-t border-slate-200 dark:border-slate-800 flex justify-end gap-3 rounded-b-xl">
                        <button type="button" onclick="closeCreateAttributeModal()"
                            class="px-5 py-2 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Cancel</button>
                        <button type="submit" id="saveNewAttrBtn"
                            class="px-5 py-2 bg-[#e83e8c] text-white rounded-lg hover:bg-pink-700 shadow-sm flex items-center">
                            Save Attribute
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
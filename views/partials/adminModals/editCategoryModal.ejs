<div id="editCategoryModal" class="fixed inset-0 z-[50] hidden" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity opacity-0" id="editModalBackdrop">
    </div>

    <div class="fixed inset-0 z-[60] w-screen overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4">
            <div id="editModalPanel"
                class="relative transform overflow-hidden rounded-xl bg-slate-50 dark:bg-slate-900 text-left shadow-2xl transition-all sm:w-full sm:max-w-5xl opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">

                <div
                    class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex items-center justify-between sticky top-0 z-10">
                    <div>
                        <h3 class="text-xl font-bold text-slate-800 dark:text-white">Edit Category</h3>
                        <p class="text-sm text-slate-500 mt-0.5">Modify the details of this product category.</p>
                    </div>
                    <button type="button" onclick="closeEditCategoryModal()"
                        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <div id="editCategoryError"
                    class="hidden mx-6 mt-4 bg-red-50 border-l-4 border-red-500 p-4 text-red-700 text-sm rounded-md shadow-sm">
                    <p id="editCategoryErrorText"></p>
                </div>

                <form id="editCategoryForm" onsubmit="submitEditCategoryForm(event)" enctype="multipart/form-data">
                    <input type="hidden" id="editCategoryId" name="categoryId">

                    <div class="p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="lg:col-span-2 space-y-5">
                            <div
                                class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
                                <div class="space-y-4">
                                    <div>
                                        <label
                                            class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Category
                                            Name <span class="text-[#e83e8c]">*</span></label>
                                        <input type="text" id="editCategoryName" name="name" required
                                            class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-slate-50 dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-[#e83e8c]/30 focus:border-[#e83e8c] outline-none transition-all">
                                    </div>

                                    <div>
                                        <label
                                            class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Description
                                            <span class="text-[#e83e8c]">*</span></label>
                                        <textarea id="editCategoryDescription" name="description" rows="3" required
                                            class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-slate-50 dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-[#e83e8c]/30 focus:border-[#e83e8c] outline-none transition-all resize-none"></textarea>
                                    </div>

                                    <div>
                                        <label
                                            class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Category
                                            Image</label>
                                        <div
                                            class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-slate-300 dark:border-slate-600 border-dashed rounded-xl hover:border-[#e83e8c] dark:hover:border-[#e83e8c] transition-colors relative group overflow-hidden bg-slate-50 dark:bg-slate-700/50">
                                            <div id="editUploadPlaceholder" class="space-y-1 text-center hidden">
                                                <span
                                                    class="material-symbols-outlined text-4xl text-slate-400">image</span>
                                                <div
                                                    class="flex text-sm text-slate-600 dark:text-slate-400 justify-center">
                                                    <label for="editCategoryImage"
                                                        class="relative cursor-pointer rounded-md font-medium text-[#e83e8c] hover:text-pink-600 focus-within:outline-none">
                                                        <span>Upload a new file</span>
                                                        <input id="editCategoryImage" name="categoryImage" type="file"
                                                            class="sr-only" accept="image/jpeg, image/png, image/webp"
                                                            onchange="previewEditCategoryImage(event)">
                                                    </label>
                                                </div>
                                                <p class="text-xs text-slate-500">PNG, JPG, WEBP up to 5MB</p>
                                            </div>
                                            <img id="editImagePreview" src="" alt="Preview"
                                                class="mx-auto max-h-40 rounded-lg object-contain">
                                            <label for="editCategoryImage"
                                                class="absolute inset-0 flex items-center justify-center bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                                <span
                                                    class="text-white text-sm font-medium bg-black/50 px-3 py-1.5 rounded-lg backdrop-blur-sm">Click
                                                    to Replace</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="lg:col-span-1 space-y-5">
                            <div
                                class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm h-full flex flex-col">
                                <div class="flex items-center justify-between mb-4">
                                    <h4 class="text-lg font-semibold text-slate-800 dark:text-white">Category Attributes
                                    </h4>
                                    <button type="button" onclick="openCreateAttributeModal()"
                                        class="inline-flex items-center px-3 py-1.5 bg-pink-50 text-pink-600 hover:bg-pink-100 dark:bg-pink-900/20 dark:text-pink-400 text-xs font-medium rounded-lg transition-colors">
                                        <span class="material-symbols-outlined text-[16px] mr-1">add</span>
                                        Create New
                                    </button>
                                </div>

                                <div class="mb-3 relative">
                                    <span
                                        class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">search</span>
                                    <input type="text" id="editAttributeSearchInput"
                                        onkeyup="filterEditCategoryAttributes()"
                                        class="w-full pl-9 pr-3 py-2 border border-slate-200 dark:border-slate-700 rounded-lg text-sm bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white outline-none focus:border-[#e83e8c] transition-colors"
                                        placeholder="Search attributes...">
                                </div>

                                <div class="flex-grow bg-slate-50 dark:bg-slate-700/50 rounded-lg border border-slate-200 dark:border-slate-700 p-2 overflow-y-auto max-h-[250px]"
                                    id="editAttributeCheckboxList">
                                    <% if (typeof allAttributes !=='undefined' && allAttributes.length> 0) { %>
                                        <% allAttributes.forEach(attr=> { %>
                                            <div
                                                class="attribute-list-item flex items-center justify-between p-2 hover:bg-white dark:hover:bg-slate-800 rounded-md transition-colors border border-transparent hover:border-slate-200 dark:hover:border-slate-600 group">

                                                <label class="flex items-center cursor-pointer flex-grow">
                                                    <input type="checkbox" name="categoryAttributes[]"
                                                        value="<%= attr._id %>"
                                                        class="w-4 h-4 text-[#e83e8c] bg-slate-100 border-slate-300 rounded focus:ring-[#e83e8c] dark:bg-slate-700 dark:border-slate-600">
                                                    <div class="ml-3 flex flex-col">
                                                        <span
                                                            class="attr-display-name text-sm font-medium text-slate-900 dark:text-white">
                                                            <%= attr.displayLabel %>
                                                        </span>
                                                        <span class="text-xs text-slate-500">
                                                            <%= attr.dataType %>
                                                        </span>
                                                    </div>
                                                </label>

                                                <div class="flex opacity-0 group-hover:opacity-100 transition-all">
                                                    <button type="button"
                                                        onclick="openEditGlobalAttribute('<%= attr._id %>')"
                                                        class="text-slate-400 hover:text-blue-500 p-1.5 rounded-md hover:bg-blue-50 dark:hover:bg-blue-900/20"
                                                        title="Edit Attribute">
                                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                                    </button>
                                                    <button type="button"
                                                        onclick="deleteGlobalAttribute('<%= attr._id %>', this)"
                                                        class="text-slate-400 hover:text-red-500 p-1.5 rounded-md hover:bg-red-50 dark:hover:bg-red-900/20"
                                                        title="Delete Attribute">
                                                        <span
                                                            class="material-symbols-outlined text-[18px]">delete</span>
                                                    </button>
                                                </div>

                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <p class="text-sm text-slate-500 text-center py-4"
                                                        id="emptyAttributeMsg">No attributes available.</p>
                                                    <% } %>
                                </div>

                                <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-700">
                                    <label class="flex items-center cursor-pointer">
                                        <div class="relative">
                                            <input type="checkbox" id="editStatusCheckbox" name="status" value="active"
                                                class="sr-only peer">

                                            <div
                                                class="block bg-slate-200 dark:bg-slate-700 w-10 h-6 rounded-full transition-colors peer-checked:bg-[#e83e8c]">
                                            </div>

                                            <div
                                                class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform peer-checked:translate-x-4">
                                            </div>
                                        </div>
                                        <div class="ml-3 text-sm font-medium text-slate-700 dark:text-slate-300">Active
                                            Status</div>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div
                        class="px-6 py-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 rounded-b-xl flex items-center justify-end space-x-3">
                        <button type="button" onclick="closeEditCategoryModal()"
                            class="px-5 py-2.5 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-medium text-sm rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Cancel</button>
                        <button type="submit" id="updateCategoryBtn"
                            class="inline-flex items-center justify-center px-5 py-2.5 bg-[#e83e8c] text-white font-medium text-sm rounded-lg hover:bg-pink-600 transition-colors shadow-sm min-w-[140px]">
                            <span class="material-symbols-outlined text-[18px] mr-2">save</span>
                            Update Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
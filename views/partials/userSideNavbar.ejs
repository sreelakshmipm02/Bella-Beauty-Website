<main class="max-w-7xl mx-auto px-6 py-12">
    <div class="flex flex-col lg:flex-row gap-12">
        <aside class="w-full lg:w-72 space-y-8">
            <div
                class="bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-sm border border-pink-50 dark:border-slate-700/50">
                <div class="flex items-center gap-4 mb-10">
                    <div
                        class="w-16 h-16 rounded-full bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center text-primary text-xl font-semibold">
                        <%= (user.firstName?.charAt(0) || '' ) + (user.lastName?.charAt(0) || user.firstName?.charAt(1))
                            %>


                    </div>
                    <div>
                        <h3 class="font-semibold text-lg">
                            <%= user.firstName %>
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            <%= user.email %>
                        </p>
                    </div>
                </div>
                <nav class="space-y-2">
                    <a class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl" href="#" data-target="account">

                        <span class="material-symbols-outlined">account_circle</span>
                        <span>Account Overview</span>
                    </a>
                    <a class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl" href="#" data-target="orders">

                        <span class="material-symbols-outlined">local_shipping</span>
                        <span>My Orders</span>
                    </a>
                    <a class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl" href="#" data-target="address">

                        <span class="material-symbols-outlined">location_on</span>
                        <span>Manage Address</span>
                    </a>
                    <a class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl" href="#" data-target="wallet">

                        <span class="material-symbols-outlined">account_balance_wallet</span>
                        <span>Wallet</span>
                    </a>
                    <a class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl" href="#" data-target="password">

                        <span class="material-symbols-outlined">lock</span>
                        <span>Manage Password</span>
                    </a>
                    <!-- SIGN OUT (fixed bottom) -->
                    <script src="/js/logoutPopup.js"></script>
                    <script>
                        document.addEventListener("DOMContentLoaded", () => {
                            const navLinks = document.querySelectorAll(".nav-link");

                            navLinks.forEach(link => {
                                link.addEventListener("click", function () {
                                    // Remove active from all
                                    navLinks.forEach(nav => nav.classList.remove("active"));
                                    // Add to the clicked one
                                    this.classList.add("active");
                                });
                            });
                            // Set 'Account Overview' as active by default on load
                            const defaultTab = document.querySelector('[data-target="account"]');
                            if (defaultTab) defaultTab.classList.add("active");
                        });
                    </script>
                    <div class="p-4 border-t border-slate-200 dark:border-slate-800">
                        <button onclick="confirmLogout('/logout')"
                            class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-xl bg-red-500 hover:bg-red-600 text-white font-semibold transition shadow-lg shadow-red-500/20">
                            <span class="material-icons-outlined">logout</span>
                            Sign Out
                        </button>
                    </div>
                </nav>
            </div>
        </aside>
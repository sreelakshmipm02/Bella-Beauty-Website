<%- include("../partials/header") %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 min-h-screen bg-white">
        <h1 class="text-3xl font-bold font-display text-gray-900 mb-8">Checkout</h1>

        <div class="flex flex-col lg:flex-row gap-10">
            <div class="flex-1 space-y-8">

                <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200 relative">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
                            <span class="material-icons-outlined text-primary">location_on</span> Delivery Address
                        </h2>
                        <button type="button" onclick="openAddModal(event)"
                            class="text-sm text-primary hover:underline font-bold flex items-center gap-1">
                            <span class="material-icons-outlined text-sm">add</span> Add New
                        </button>
                    </div>

                    <% if (addresses.length===0) { %>
                        <div class="text-center py-8 bg-white rounded-xl border border-dashed border-gray-300">
                            <p class="text-gray-500 mb-4">You don't have any saved addresses.</p>
                            <button type="button" onclick="openAddModal(event)" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-pink-700 transition">Add Address</button>
                        </div>
                        <% } else { %>
                            <div class="grid gap-4">
                                <% addresses.forEach((addr, index)=> { %>
                                    <label class="cursor-pointer relative block">
                                        <input type="radio" name="selectedAddress" value="<%= addr._id %>" class="peer sr-only" <%=addr.isDefault || index===0 ? 'checked' : '' %>>
                                        <div class="p-4 bg-white rounded-xl border-2 border-gray-200 peer-checked:border-primary peer-checked:bg-primary/5 hover:border-gray-300 transition">
                                            <div class="flex justify-between items-start">
                                                <div>
                                                    <p class="font-bold text-gray-900"><%= addr.fullName %></p>
                                                    <p class="text-sm text-gray-600 mt-1">
                                                        <%= addr.addressLine1 %>
                                                        <% if (addr.addressLine2) { %>, <%= addr.addressLine2 %><% } %>
                                                    </p>
                                                    <p class="text-sm text-gray-600"><%= addr.city %>, <%= addr.state %> - <%= addr.postalCode %></p>
                                                    <p class="text-sm text-gray-600 mt-2 font-medium">Phone: <%= addr.phone %></p>
                                                </div>

                                                <div class="flex flex-col items-end gap-3">
                                                    <span class="material-icons-outlined text-primary opacity-0 peer-checked:opacity-100 transition-opacity">check_circle</span>
                                                    <button type="button" onclick="openEditModal(event, '<%= addr._id %>')" class="text-sm text-gray-500 hover:text-primary transition font-medium flex items-center gap-1 relative z-10">
                                                        <span class="material-icons-outlined text-[16px]">edit</span> Edit
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </label>
                                    <% }) %>
                            </div>
                        <% } %>
                </div>

                <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200">
                    <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                        <span class="material-icons-outlined text-primary">payments</span> Payment Method
                    </h2>

                    <div class="grid gap-4">
                        <label class="cursor-pointer relative">
                            <input type="radio" name="paymentMethod" value="COD" class="peer sr-only" checked>
                            <div class="p-4 bg-white rounded-xl border-2 border-gray-200 peer-checked:border-primary peer-checked:bg-primary/5 hover:border-gray-300 transition flex items-center gap-4">
                                <span class="material-icons-outlined text-gray-400 peer-checked:text-primary">local_shipping</span>
                                <div>
                                    <p class="font-bold text-gray-900">Cash on Delivery (COD)</p>
                                    <p class="text-sm text-gray-500">Pay when your order arrives.</p>
                                </div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <div class="w-full lg:w-1/3">
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm sticky top-24">
                    <h3 class="text-lg font-bold text-gray-900 mb-6 border-b pb-4">Order Summary</h3>

                    <div class="max-h-64 overflow-y-auto custom-scrollbar pr-2 mb-6">
                        <% cart.items.forEach(item=> { %>
                            <div class="flex gap-4 mb-4">
                                <div class="w-16 h-16 rounded-lg bg-gray-50 overflow-hidden shrink-0 border border-gray-100">
                                    <img src="<%= item.image %>" class="w-full h-full object-cover">
                                </div>
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-gray-900 line-clamp-2"><%= item.productName %></p>
                                    <p class="text-xs text-gray-500 mt-1">Qty: <%= item.quantity %></p>
                                </div>
                                <p class="text-sm font-bold text-gray-900">₹<%= item.itemTotal %></p>
                            </div>
                            <% }) %>
                    </div>

                    <div class="space-y-3 text-sm text-gray-600 border-t border-b border-gray-100 py-4 mb-6">
                        <div class="flex justify-between">
                            <span>Subtotal</span>
                            <span class="font-medium text-gray-900">₹<%= cart.summary.subtotal %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Tax (GST)</span>
                            <span class="font-medium text-gray-900">₹<%= cart.summary.tax %></span>
                        </div>
                        <div class="flex justify-between <%= cart.summary.shipping === 0 ? 'text-green-600' : 'text-gray-600' %>">
    <span>Delivery</span>
    <span class="font-medium">
        <%= cart.summary.shipping === 0 ? 'Free' : '+ ₹' + cart.summary.shipping.toFixed(2) %>
    </span>
</div>
                    </div>

                    <div class="flex justify-between items-end mb-8">
                        <span class="font-bold text-gray-900">Total</span>
                        <span class="text-2xl font-bold text-primary">₹<%= cart.summary.total %></span>
                    </div>

                    <button id="placeOrderBtn"
                        class="w-full bg-gray-900 hover:bg-primary text-white text-lg font-bold py-4 rounded-xl transition flex justify-center items-center gap-2 shadow-lg disabled:opacity-50 disabled:cursor-not-allowed">
                        Place Order <span class="material-icons-outlined text-sm">arrow_forward</span>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <div id="addressModal" class="fixed inset-0 z-[100] hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4 transition-opacity">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl overflow-hidden">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <h3 class="text-xl font-bold text-gray-900 font-display" id="modalTitle">Add New Address</h3>
                <button type="button" onclick="closeAddressModal()" class="text-gray-400 hover:text-red-500 transition">
                    <span class="material-icons-outlined">close</span>
                </button>
            </div>
            <form id="addressForm" class="p-6 space-y-4">
                <input type="hidden" id="addressId" name="addressId">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                        <input type="text" id="fullName" required class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                        <input type="tel" id="phone" required class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Address Line 1</label>
                    <input type="text" id="addressLine1" required class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Address Line 2 <span class="text-gray-400 font-normal">(Optional)</span></label>
                    <input type="text" id="addressLine2" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">City</label>
                        <input type="text" id="city" required class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
                        <input type="text" id="state" required class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Postal Code</label>
                        <input type="text" id="postalCode" required class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Country</label>
                        <input type="text" id="country" value="India" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                </div>
                <div class="pt-6 mt-6 border-t border-gray-100 flex justify-end gap-3">
                    <button type="button" onclick="closeAddressModal()" class="px-6 py-2.5 rounded-lg font-bold text-gray-600 hover:bg-gray-100 transition">Cancel</button>
                    <button type="submit" id="saveAddressBtn" class="px-8 py-2.5 rounded-lg font-bold bg-primary text-white hover:bg-pink-700 transition shadow-md">Save Address</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const savedAddresses = <%- JSON.stringify(addresses || []) %>;
        function openAddModal(e) {
            if (e) e.preventDefault();
            document.getElementById('modalTitle').innerText = 'Add New Address';
            document.getElementById('addressForm').reset();
            document.getElementById('addressId').value = '';
            document.getElementById('country').value = 'India';
            document.getElementById('addressModal').classList.remove('hidden');
        }

        function openEditModal(e, addressId) {
            e.preventDefault();
            e.stopPropagation(); 
            const address = savedAddresses.find(a => a._id === addressId);
            if (!address) return;
            document.getElementById('modalTitle').innerText = 'Edit Address';
            document.getElementById('addressId').value = address._id;
            document.getElementById('fullName').value = address.fullName;
            document.getElementById('phone').value = address.phone;
            document.getElementById('addressLine1').value = address.addressLine1;
            document.getElementById('addressLine2').value = address.addressLine2 || '';
            document.getElementById('city').value = address.city;
            document.getElementById('state').value = address.state;
            document.getElementById('postalCode').value = address.postalCode;
            document.getElementById('country').value = address.country || 'India';
            document.getElementById('addressModal').classList.remove('hidden');
        }

        function closeAddressModal() {
            document.getElementById('addressModal').classList.add('hidden');
        }

        document.getElementById('addressForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('saveAddressBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="material-icons-outlined animate-spin text-sm">refresh</span> Saving...';
            btn.disabled = true;
            const id = document.getElementById('addressId').value;
            const formData = {
                fullName: document.getElementById('fullName').value,
                phone: document.getElementById('phone').value,
                addressLine1: document.getElementById('addressLine1').value,
                addressLine2: document.getElementById('addressLine2').value,
                city: document.getElementById('city').value,
                state: document.getElementById('state').value,
                postalCode: document.getElementById('postalCode').value,
                country: document.getElementById('country').value,
            };
            const url = id ? `/address/${id}` : `/address`;
            const method = id ? 'PUT' : 'POST';
            try {
                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Saved!', text: data.message, timer: 1500, showConfirmButton: false, toast: true, position: 'top-end' });
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Network error. Please try again.', 'error');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });

        document.getElementById('placeOrderBtn').addEventListener('click', async function () {
            const addressInput = document.querySelector('input[name="selectedAddress"]:checked');
            const paymentInput = document.querySelector('input[name="paymentMethod"]:checked');

            if (!addressInput) {
                return Swal.fire('Address Required', 'Please select a delivery address to continue.', 'warning');
            }

            const originalText = this.innerHTML;
            this.innerHTML = '<span class="material-icons-outlined animate-spin text-sm">refresh</span> Processing...';
            this.disabled = true;

            try {
                const response = await fetch('/orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        addressId: addressInput.value,
                        paymentMethod: paymentInput.value
                    })
                });
                const data = await response.json();

                if (data.success) {
                    // 1. Check if backend sends the orderId directly
                    let finalOrderId = data.orderId;

                    // 2. If it sends the old redirectUrl ('/order-success/12345'), extract the ID from it
                    if (!finalOrderId && data.redirectUrl) {
                        finalOrderId = data.redirectUrl.split('/').pop();
                    }

                    // 3. Force the strict RESTful URL format
                    window.location.href = `/orders/${finalOrderId}/success`;
                    
                } else {
                    Swal.fire('Checkout Failed', data.message, 'error');
                    this.innerHTML = originalText;
                    this.disabled = false;
                }
            } catch (error) {
                Swal.fire('Error', 'Something went wrong. Please try again.', 'error');
                this.innerHTML = originalText;
                this.disabled = false;
            }
        });
    </script>

    <%- include("../partials/footer") %>
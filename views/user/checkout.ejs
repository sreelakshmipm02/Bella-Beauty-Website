<%- include("../partials/header") %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 min-h-screen bg-white">
        <h1 class="text-3xl font-bold font-display text-gray-900 mb-8">Checkout</h1>

        <div class="flex flex-col lg:flex-row gap-10">
            <div class="flex-1 space-y-8">

                <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200 relative">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
                            <span class="material-icons-outlined text-primary">location_on</span> Delivery Address
                        </h2>
                        <button type="button" onclick="openAddModal(event)"
                            class="text-sm text-primary hover:underline font-bold flex items-center gap-1">
                            <span class="material-icons-outlined text-sm">add</span> Add New
                        </button>
                    </div>

                    <% if (addresses.length===0) { %>
                        <div class="text-center py-8 bg-white rounded-xl border border-dashed border-gray-300">
                            <p class="text-gray-500 mb-4">You don't have any saved addresses.</p>
                            <button type="button" onclick="openAddModal(event)" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-pink-700 transition">Add Address</button>
                        </div>
                        <% } else { %>
                            <div class="grid gap-4">
                                <% addresses.forEach((addr, index)=> { %>
                                    <label class="cursor-pointer relative block">
                                        <input type="radio" name="selectedAddress" value="<%= addr._id %>" class="peer sr-only">
                                        <div class="p-4 bg-white rounded-xl border-2 border-gray-200 peer-checked:border-primary peer-checked:bg-primary/5 hover:border-gray-300 transition">
                                            <div class="flex justify-between items-start">
                                                <div>
                                                    <p class="font-bold text-gray-900"><%= addr.fullName %></p>
                                                    <p class="text-sm text-gray-600 mt-1">
                                                        <%= addr.addressLine1 %>
                                                        <% if (addr.addressLine2) { %>, <%= addr.addressLine2 %><% } %>
                                                    </p>
                                                    <p class="text-sm text-gray-600"><%= addr.city %>, <%= addr.state %> - <%= addr.postalCode %></p>
                                                    <p class="text-sm text-gray-600 mt-2 font-medium">Phone: <%= addr.phone %></p>
                                                </div>

                                                <div class="flex flex-col items-end gap-3">
                                                    <span class="material-icons-outlined text-primary opacity-0 peer-checked:opacity-100 transition-opacity">check_circle</span>
                                                    <button type="button" onclick="openEditModal(event, '<%= addr._id %>')" class="text-sm text-gray-500 hover:text-primary transition font-medium flex items-center gap-1 relative z-10">
                                                        <span class="material-icons-outlined text-[16px]">edit</span> Edit
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </label>
                                    <% }) %>
                            </div>
                        <% } %>
                </div>

                <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200">
                    <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                        <span class="material-icons-outlined text-primary">payments</span> Payment Method
                    </h2>

                    <div class="grid gap-4">
                        <label class="cursor-pointer relative <%= wallet.isSufficient ? '' : 'opacity-70' %>">
                            <input type="radio" name="paymentMethod" value="Wallet" class="peer sr-only" <%= wallet.isSufficient ? '' : 'disabled' %>>
                            <div class="p-4 bg-white rounded-xl border-2 border-gray-200 peer-checked:border-primary peer-checked:bg-primary/5 hover:border-gray-300 transition flex items-center gap-4">
                                <span class="material-icons-outlined text-gray-400 peer-checked:text-primary">account_balance_wallet</span>
                                <div class="flex-1">
                                    <p class="font-bold text-gray-900">Bella Wallet</p>
                                    <p class="text-sm text-gray-500">Available balance: ₹<%= wallet.balance.toFixed(2) %></p>
                                    <% if (wallet.isSufficient) { %>
                                        <p class="text-xs text-green-600 mt-1">Your order total will be debited instantly from the wallet.</p>
                                    <% } else { %>
                                        <p class="text-xs text-amber-600 mt-1">You need ₹<%= wallet.shortfall.toFixed(2) %> more in your wallet to use this option.</p>
                                    <% } %>
                                </div>
                            </div>
                        </label>

                        <% if (razorpayEnabled) { %>
                            <label class="cursor-pointer relative">
                                <input type="radio" name="paymentMethod" value="Online" class="peer sr-only">
                                <div class="p-4 bg-white rounded-xl border-2 border-gray-200 peer-checked:border-primary peer-checked:bg-primary/5 hover:border-gray-300 transition flex items-center gap-4">
                                    <span class="material-icons-outlined text-gray-400 peer-checked:text-primary">credit_card</span>
                                    <div>
                                        <p class="font-bold text-gray-900">Online Payment</p>
                                        <p class="text-sm text-gray-500">Pay securely with Razorpay using UPI, cards, net banking, or wallets.</p>
                                    </div>
                                </div>
                            </label>
                        <% } %>

                        <label class="cursor-pointer relative">
                            <input type="radio" name="paymentMethod" value="COD" class="peer sr-only">
                            <div class="p-4 bg-white rounded-xl border-2 border-gray-200 peer-checked:border-primary peer-checked:bg-primary/5 hover:border-gray-300 transition flex items-center gap-4">
                                <span class="material-icons-outlined text-gray-400 peer-checked:text-primary">local_shipping</span>
                                <div>
                                    <p class="font-bold text-gray-900">Cash on Delivery (COD)</p>
                                    <p class="text-sm text-gray-500">Pay when your order arrives. No wallet refund is created unless a paid order is later returned.</p>
                                </div>
                            </div>
                        </label>
                    </div>

                    <% if (!razorpayEnabled) { %>
                        <p class="mt-3 text-sm text-amber-600">Online payment is temporarily unavailable because Razorpay is not configured.</p>
                    <% } %>
                </div>
            </div>

            <div class="w-full lg:w-1/3">
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm sticky top-24">
                    <h3 class="text-lg font-bold text-gray-900 mb-6 border-b pb-4">Order Summary</h3>

                    <div class="mb-6 rounded-2xl bg-gray-50 border border-gray-200 p-4">
                        <div class="flex items-center justify-between gap-3 mb-3">
                            <div>
                                <p class="font-semibold text-gray-900">Coupon</p>
                                <p class="text-xs text-gray-500">Use any available coupon below.</p>
                            </div>
                            <span id="checkoutCouponBadge" class="<%= cart.appliedCoupon ? '' : 'hidden' %> inline-flex items-center gap-1 bg-green-50 text-green-700 text-xs font-bold px-3 py-1 rounded-full">
                                <span class="material-icons-outlined text-sm">sell</span>
                                <span id="checkoutCouponBadgeCode"><%= cart.appliedCoupon?.code || '' %></span>
                            </span>
                        </div>

                        <div class="flex gap-2 mb-4">
                            <input
                                id="checkoutCouponCode"
                                type="text"
                                placeholder="Enter coupon code"
                                value="<%= cart.appliedCoupon?.code || '' %>"
                                <%= cart.appliedCoupon ? 'disabled' : '' %>
                                class="flex-1 rounded-xl border border-gray-200 px-4 py-3 text-sm uppercase focus:border-primary focus:ring-primary disabled:bg-gray-100 disabled:text-gray-500">
                            <button
                                id="checkoutCouponBtn"
                                type="button"
                                onclick="<%= cart.appliedCoupon ? 'removeCheckoutCoupon()' : 'applyCheckoutCoupon()' %>"
                                class="<%= cart.appliedCoupon ? 'rounded-xl border border-red-200 bg-red-50 text-red-600 px-4 py-3 text-sm font-bold hover:bg-red-100 transition' : 'rounded-xl bg-gray-900 text-white px-4 py-3 text-sm font-bold hover:bg-primary transition' %>">
                                <%= cart.appliedCoupon ? 'Remove' : 'Apply' %>
                            </button>
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-sm font-semibold text-gray-900">Available Coupons</p>
                                <span class="text-xs text-gray-400"><%= cart.availableCoupons?.length || 0 %> available</span>
                            </div>
                            <div id="checkoutAvailableCoupons" class="space-y-3 max-h-60 overflow-y-auto pr-1">
                                <% if (cart.availableCoupons?.length) { %>
                                    <% cart.availableCoupons.forEach((coupon) => { %>
                                        <div class="rounded-xl border <%= coupon.isApplied ? 'border-green-200 bg-green-50/70' : coupon.isEligible ? 'border-pink-100 bg-pink-50/50' : 'border-gray-200 bg-gray-50' %> p-3">
                                            <div class="flex items-start justify-between gap-3">
                                                <div>
                                                    <p class="font-bold text-gray-900"><%= coupon.code %></p>
                                                    <p class="text-sm text-gray-600"><%= coupon.discountLabel %></p>
                                                    <p class="text-xs <%= coupon.isEligible ? 'text-green-600' : 'text-amber-600' %> mt-1"><%= coupon.message %></p>
                                                </div>
                                                <button
                                                    type="button"
                                                    <%= coupon.isEligible && !coupon.isApplied && !cart.appliedCoupon ? '' : 'disabled' %>
                                                    onclick="applySuggestedCheckoutCoupon('<%= coupon.code %>')"
                                                    class="shrink-0 rounded-lg px-3 py-2 text-xs font-bold transition <%= coupon.isApplied ? 'bg-green-600 text-white cursor-default' : coupon.isEligible && !cart.appliedCoupon ? 'bg-gray-900 text-white hover:bg-primary' : 'bg-gray-200 text-gray-400 cursor-not-allowed' %>">
                                                    <%= coupon.isApplied ? 'Applied' : 'Apply' %>
                                                </button>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <p class="text-sm text-gray-500">No coupons available right now.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div id="checkoutSummaryItems" class="max-h-64 overflow-y-auto custom-scrollbar pr-2 mb-6">
                        <% cart.items.forEach(item=> { %>
                            <div class="flex gap-4 mb-4">
                                <div class="w-16 h-16 rounded-lg bg-gray-50 overflow-hidden shrink-0 border border-gray-100">
                                    <img src="<%= item.image %>" class="w-full h-full object-cover">
                                </div>
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-gray-900 line-clamp-2"><%= item.productName %></p>
                                    <p class="text-xs text-gray-500 mt-1">Qty: <%= item.quantity %></p>
                                    <% if (item.appliedOffer) { %>
                                        <p class="text-[11px] text-green-600 font-semibold mt-1"><%= item.appliedOffer.label %> applied</p>
                                    <% } %>
                                </div>
                                <div class="text-right">
                                    <p class="text-sm font-bold text-gray-900">₹<%= item.itemTotal %></p>
                                    <% if (item.appliedOffer && item.originalItemTotal !== item.itemTotal) { %>
                                        <p class="text-xs text-gray-400 line-through">₹<%= item.originalItemTotal %></p>
                                    <% } %>
                                </div>
                            </div>
                            <% }) %>
                    </div>

                    <div class="space-y-3 text-sm text-gray-600 border-t border-b border-gray-100 py-4 mb-6">
                        <div class="flex justify-between">
                            <span>Items Total</span>
                            <span id="checkoutOriginalSubtotal" class="font-medium text-gray-900">₹<%= cart.summary.originalGrossSubtotal || cart.summary.grossSubtotal %></span>
                        </div>
                        <div class="flex justify-between text-green-600">
                            <span>Offer Savings</span>
                            <span id="checkoutOfferSavings" class="font-medium">- ₹<%= cart.summary.offerSavings || '0.00' %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Subtotal</span>
                            <span id="checkoutSubtotal" class="font-medium text-gray-900">₹<%= cart.summary.subtotal %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Tax (GST)</span>
                            <span id="checkoutTax" class="font-medium text-gray-900">₹<%= cart.summary.tax %></span>
                        </div>
                        <div class="flex justify-between text-green-600">
                            <span>Discount</span>
                            <span id="checkoutDiscount" class="font-medium">- ₹<%= cart.summary.discount || '0.00' %></span>
                        </div>
                        <div id="checkoutDeliveryRow" class="flex justify-between <%= cart.summary.shipping === 0 ? 'text-green-600' : 'text-gray-600' %>">
                            <span>Delivery</span>
                            <span id="checkoutDelivery" class="font-medium">
                                <%= cart.summary.shipping === 0 ? 'Free' : '+ ₹' + cart.summary.shipping.toFixed(2) %>
                            </span>
                        </div>
                    </div>

                    <div class="flex justify-between items-end mb-8">
                        <span class="font-bold text-gray-900">Total</span>
                        <span id="checkoutTotal" class="text-2xl font-bold text-primary">₹<%= cart.summary.total %></span>
                    </div>

                    <button id="placeOrderBtn"
                        class="w-full bg-gray-900 hover:bg-primary text-white text-lg font-bold py-4 rounded-xl transition flex justify-center items-center gap-2 shadow-lg disabled:opacity-50 disabled:cursor-not-allowed">
                        Place Order <span class="material-icons-outlined text-sm">arrow_forward</span>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <div id="addressModal" class="fixed inset-0 z-[100] hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4 transition-opacity">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl overflow-hidden">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <h3 class="text-xl font-bold text-gray-900 font-display" id="modalTitle">Add New Address</h3>
                <button type="button" onclick="closeAddressModal()" class="text-gray-400 hover:text-red-500 transition">
                    <span class="material-icons-outlined">close</span>
                </button>
            </div>
            <form id="addressForm" class="p-6 space-y-4" novalidate>
                <input type="hidden" id="addressId" name="addressId">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                        <input type="text" id="fullName" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                        <input type="tel" id="phone" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Address Line 1</label>
                    <input type="text" id="addressLine1" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Address Line 2 <span class="text-gray-400 font-normal">(Optional)</span></label>
                    <input type="text" id="addressLine2" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">City</label>
                        <input type="text" id="city" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
                        <input type="text" id="state" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Postal Code</label>
                        <input type="text" id="postalCode" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Country</label>
                        <input type="text" id="country" value="India" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                    </div>
                </div>
                <div class="pt-6 mt-6 border-t border-gray-100 flex justify-end gap-3">
                    <button type="button" onclick="closeAddressModal()" class="px-6 py-2.5 rounded-lg font-bold text-gray-600 hover:bg-gray-100 transition">Cancel</button>
                    <button type="submit" id="saveAddressBtn" class="px-8 py-2.5 rounded-lg font-bold bg-primary text-white hover:bg-pink-700 transition shadow-md">Save Address</button>
                </div>
            </form>
        </div>
    </div>
    <script src="/js/addressValidation.js"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        const savedAddresses = <%- JSON.stringify(addresses || []) %>;
        let checkoutCartState = <%- JSON.stringify(cart) %>;
        const buildPaymentFailureUrl = (message, code = "") => {
            const params = new URLSearchParams();
            if (message) params.set("message", message);
            if (code) params.set("code", code);
            return `/payments/failure?${params.toString()}`;
        };

        function renderCheckoutAvailableCoupons(cart) {
            const list = document.getElementById('checkoutAvailableCoupons');
            if (!list) return;

            if (!cart.availableCoupons || cart.availableCoupons.length === 0) {
                list.innerHTML = '<p class="text-sm text-gray-500">No coupons available right now.</p>';
                return;
            }

            list.innerHTML = cart.availableCoupons.map(coupon => `
                <div class="rounded-xl border ${coupon.isApplied ? 'border-green-200 bg-green-50/70' : coupon.isEligible ? 'border-pink-100 bg-pink-50/50' : 'border-gray-200 bg-gray-50'} p-3">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="font-bold text-gray-900">${coupon.code}</p>
                            <p class="text-sm text-gray-600">${coupon.discountLabel}</p>
                            <p class="text-xs ${coupon.isEligible ? 'text-green-600' : 'text-amber-600'} mt-1">${coupon.message}</p>
                        </div>
                        <button
                            type="button"
                            ${coupon.isEligible && !coupon.isApplied && !cart.appliedCoupon ? '' : 'disabled'}
                            onclick="applySuggestedCheckoutCoupon('${coupon.code}')"
                            class="shrink-0 rounded-lg px-3 py-2 text-xs font-bold transition ${coupon.isApplied ? 'bg-green-600 text-white cursor-default' : coupon.isEligible && !cart.appliedCoupon ? 'bg-gray-900 text-white hover:bg-primary' : 'bg-gray-200 text-gray-400 cursor-not-allowed'}">
                            ${coupon.isApplied ? 'Applied' : 'Apply'}
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function renderCheckoutSummary(cart) {
            checkoutCartState = cart;
            const itemsList = document.getElementById('checkoutSummaryItems');
            const originalSubtotal = document.getElementById('checkoutOriginalSubtotal');
            const offerSavings = document.getElementById('checkoutOfferSavings');
            const subtotal = document.getElementById('checkoutSubtotal');
            const tax = document.getElementById('checkoutTax');
            const discount = document.getElementById('checkoutDiscount');
            const delivery = document.getElementById('checkoutDelivery');
            const deliveryRow = document.getElementById('checkoutDeliveryRow');
            const total = document.getElementById('checkoutTotal');

            if (itemsList) {
                itemsList.innerHTML = cart.items.map(item => `
                    <div class="flex gap-4 mb-4">
                        <div class="w-16 h-16 rounded-lg bg-gray-50 overflow-hidden shrink-0 border border-gray-100">
                            <img src="${item.image}" class="w-full h-full object-cover">
                        </div>
                        <div class="flex-1">
                            <p class="text-sm font-medium text-gray-900 line-clamp-2">${item.productName}</p>
                            <p class="text-xs text-gray-500 mt-1">Qty: ${item.quantity}</p>
                            ${item.appliedOffer ? `<p class="text-[11px] text-green-600 font-semibold mt-1">${item.appliedOffer.label} applied</p>` : ''}
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-bold text-gray-900">₹${item.itemTotal}</p>
                            ${item.appliedOffer && item.originalItemTotal !== item.itemTotal ? `<p class="text-xs text-gray-400 line-through">₹${item.originalItemTotal}</p>` : ''}
                        </div>
                    </div>
                `).join('');
            }

            if (originalSubtotal) originalSubtotal.innerText = `₹${cart.summary.originalGrossSubtotal || cart.summary.grossSubtotal}`;
            if (offerSavings) offerSavings.innerText = `- ₹${cart.summary.offerSavings || '0.00'}`;
            if (subtotal) subtotal.innerText = `₹${cart.summary.subtotal}`;
            if (tax) tax.innerText = `₹${cart.summary.tax}`;
            if (discount) discount.innerText = `- ₹${cart.summary.discount || '0.00'}`;
            if (delivery && deliveryRow) {
                if (cart.summary.shipping === 0) {
                    delivery.innerText = 'Free';
                    deliveryRow.className = 'flex justify-between text-green-600';
                } else {
                    delivery.innerText = `+ ₹${Number(cart.summary.shipping).toFixed(2)}`;
                    deliveryRow.className = 'flex justify-between text-gray-600';
                }
            }
            if (total) total.innerText = `₹${cart.summary.total}`;

            syncCheckoutCouponUI(cart);
        }

        function syncCheckoutCouponUI(cart) {
            const input = document.getElementById('checkoutCouponCode');
            const button = document.getElementById('checkoutCouponBtn');
            const badge = document.getElementById('checkoutCouponBadge');
            const badgeCode = document.getElementById('checkoutCouponBadgeCode');

            if (!input || !button || !badge || !badgeCode) return;

            if (cart.appliedCoupon) {
                input.value = cart.appliedCoupon.code;
                input.disabled = true;
                badge.classList.remove('hidden');
                badgeCode.textContent = cart.appliedCoupon.code;
                button.textContent = 'Remove';
                button.className = 'rounded-xl border border-red-200 bg-red-50 text-red-600 px-4 py-3 text-sm font-bold hover:bg-red-100 transition';
                button.onclick = removeCheckoutCoupon;
            } else {
                input.value = '';
                input.disabled = false;
                badge.classList.add('hidden');
                badgeCode.textContent = '';
                button.textContent = 'Apply';
                button.className = 'rounded-xl bg-gray-900 text-white px-4 py-3 text-sm font-bold hover:bg-primary transition';
                button.onclick = applyCheckoutCoupon;
            }

            renderCheckoutAvailableCoupons(cart);
        }

        async function applyCheckoutCoupon(code = null) {
            const input = document.getElementById('checkoutCouponCode');
            const button = document.getElementById('checkoutCouponBtn');
            const couponCode = (code || input.value).trim().toUpperCase();

            if (!couponCode) {
                return Swal.fire('Coupon Required', 'Please enter or select a coupon code.', 'warning');
            }

            const originalText = button.textContent;
            button.textContent = 'Applying...';
            button.disabled = true;

            try {
                const response = await fetch('/cart/coupon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code: couponCode })
                });
                const data = await response.json();

                if (data.success) {
                    renderCheckoutSummary(data.cart);
                    Swal.fire('Coupon Applied', data.message, 'success').then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Coupon Error', data.message, 'warning');
                }
            } catch (error) {
                Swal.fire('Error', 'Failed to apply coupon.', 'error');
            } finally {
                button.textContent = originalText;
                button.disabled = false;
            }
        }

        function applySuggestedCheckoutCoupon(code) {
            applyCheckoutCoupon(code);
        }

        async function removeCheckoutCoupon() {
            const button = document.getElementById('checkoutCouponBtn');
            const originalText = button.textContent;
            button.textContent = 'Removing...';
            button.disabled = true;

            try {
                const response = await fetch('/cart/coupon', { method: 'DELETE' });
                const data = await response.json();

                if (data.success) {
                    renderCheckoutSummary(data.cart);
                    Swal.fire('Coupon Removed', data.message, 'success').then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Coupon Error', data.message, 'warning');
                }
            } catch (error) {
                Swal.fire('Error', 'Failed to remove coupon.', 'error');
            } finally {
                button.textContent = originalText;
                button.disabled = false;
            }
        }

        function openAddModal(e) {
            if (e) e.preventDefault();
            document.getElementById('modalTitle').innerText = 'Add New Address';
            document.getElementById('addressForm').reset();
            document.getElementById('addressId').value = '';
            document.getElementById('country').value = 'India';
            document.getElementById('addressModal').classList.remove('hidden');
        }

        function openEditModal(e, addressId) {
            e.preventDefault();
            e.stopPropagation(); 
            const address = savedAddresses.find(a => a._id === addressId);
            if (!address) return;
            document.getElementById('modalTitle').innerText = 'Edit Address';
            document.getElementById('addressId').value = address._id;
            document.getElementById('fullName').value = address.fullName;
            document.getElementById('phone').value = address.phone;
            document.getElementById('addressLine1').value = address.addressLine1;
            document.getElementById('addressLine2').value = address.addressLine2 || '';
            document.getElementById('city').value = address.city;
            document.getElementById('state').value = address.state;
            document.getElementById('postalCode').value = address.postalCode;
            document.getElementById('country').value = address.country || 'India';
            document.getElementById('addressModal').classList.remove('hidden');
        }

        function closeAddressModal() {
            document.getElementById('addressModal').classList.add('hidden');
        }

        document.getElementById('addressForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const fullName = document.getElementById('fullName').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const addressLine1 = document.getElementById('addressLine1').value.trim();
            const addressLine2 = document.getElementById('addressLine2').value.trim();
            const city = document.getElementById('city').value.trim();
            const state = document.getElementById('state').value.trim();
            const postalCode = document.getElementById('postalCode').value.trim();
            const country = document.getElementById('country').value.trim();

            const validation = window.validateAddressFields({
                fullName,
                phone,
                addressLine1,
                city,
                state,
                postalCode
            });

            if (!validation.isValid) {
                return Swal.fire(validation.title, validation.message, validation.icon);
            }

            const btn = document.getElementById('saveAddressBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="material-icons-outlined animate-spin text-sm">refresh</span> Saving...';
            btn.disabled = true;
            const id = document.getElementById('addressId').value;
            const formData = {
                fullName,
                phone,
                addressLine1,
                addressLine2,
                city,
                state,
                postalCode,
                country,
            };
            const url = id ? `/address/${id}` : `/address`;
            const method = id ? 'PUT' : 'POST';
            try {
                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Saved!', text: data.message, timer: 1500, showConfirmButton: false, toast: true, position: 'top-end' });
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Network error. Please try again.', 'error');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });

        document.getElementById('placeOrderBtn').addEventListener('click', async function () {
    const addressInput = document.querySelector('input[name="selectedAddress"]:checked');
    const paymentInput = document.querySelector('input[name="paymentMethod"]:checked');

    if (!addressInput && !paymentInput) {
        return Swal.fire('Selection Required', 'Please select a delivery address and payment method to continue.', 'warning');
    }

    if (!addressInput) {
        return Swal.fire('Address Required', 'Please select a delivery address to continue.', 'warning');
    }

    if (!paymentInput) {
        return Swal.fire('Payment Required', 'Please select a payment method to continue.', 'warning');
    }

    const btn = this;
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="material-icons-outlined animate-spin text-sm">refresh</span> Processing...';
    btn.disabled = true;

    try {
        const response = await fetch('/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                addressId: addressInput.value,
                paymentMethod: paymentInput.value
            })
        });

        const data = await response.json();

        if (data.success) {
            if (data.isOnline) {
                // Launch Razorpay
                const options = {
                    key: data.key,
                    amount: data.amount,
                    currency: "INR",
                    name: "Bella",
                    description: "Order Checkout",
                    order_id: data.razorpayOrderId,
                    theme: { color: "#ec4899" }, // Matches your primary pink Tailwind class!
                    handler: async function (response) {
                        // Payment Successful! Send proof to backend for DB saving
                        try {
                            btn.innerHTML = '<span class="material-icons-outlined animate-spin text-sm">refresh</span> Verifying...';
                            const verifyRes = await fetch('/orders/verify-payment', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_signature: response.razorpay_signature,
                                    addressId: addressInput.value
                                })
                            });
                            const verifyData = await verifyRes.json();
                            if (verifyData.success) {
                                window.location.href = `/orders/${verifyData.orderId}/success`;
                            } else {
                                window.location.href = buildPaymentFailureUrl(
                                    verifyData.message || 'Payment verification failed.',
                                    response.razorpay_payment_id
                                );
                            }
                        } catch (err) {
                            window.location.href = buildPaymentFailureUrl('Failed to verify your payment. Please try again.');
                        }
                    },
                    modal: {
                        ondismiss: function () {
                            window.location.href = buildPaymentFailureUrl('You closed the payment window before completing the transaction.');
                        }
                    }
                };
                
                const rzp = new Razorpay(options);
                rzp.on('payment.failed', function (response) {
                    const failure = response.error || {};
                    window.location.href = buildPaymentFailureUrl(
                        failure.description || 'Your payment failed or was cancelled.',
                        failure.metadata?.payment_id || failure.code || ''
                    );
                });
                rzp.open();

            } else {
                // Standard COD flow redirect
                window.location.href = `/orders/${data.orderId}/success`;
            }
        } else {
            Swal.fire('Checkout Failed', data.message, 'error');
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    } catch (error) {
        Swal.fire('Error', 'Something went wrong. Please try again.', 'error');
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
});
    </script>


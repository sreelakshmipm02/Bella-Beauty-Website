<% if (isLoggedIn) { %>
    <%- include("../partials/header") %>
<% } else { %>
    <%- include("../partials/indexHeader") %>
<% } %>

<main class="bg-white">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-sm text-gray-500 border-b border-gray-100">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span class="mx-2">/</span>
        <a href="/shop" class="hover:text-primary transition">Shop</a>
        <span class="mx-2">/</span>
        <a href="/shop?category=<%= category._id %>" class="hover:text-primary transition"><%= category.name %></a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium"><%= product.name %></span>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="flex flex-col lg:flex-row gap-12">

            <div class="w-full lg:w-1/2 flex flex-col gap-4">
                <div class="relative bg-gray-50 rounded-2xl overflow-hidden cursor-crosshair border border-gray-100 aspect-square group" onmousemove="zoomImage(event)" onmouseleave="resetZoom(event)">
                    <span id="stockBadge" class="absolute top-4 left-4 bg-red-600 text-white text-xs font-bold uppercase px-3 py-1.5 rounded z-10 hidden shadow-md">Out of Stock</span>
                    <img id="mainImage" src="<%= variants[0].images[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover transition-transform duration-200 origin-center" />
                </div>
                <div class="flex gap-4 overflow-x-auto pb-2" id="thumbnailContainer"></div>
            </div>

            <div class="w-full lg:w-1/2 flex flex-col">
                <p class="text-sm text-gray-500 uppercase tracking-widest font-semibold mb-2"><%= product.brand %></p>
                <p class="text-sm text-primary font-semibold tracking-wide uppercase mb-1"><%= product.productType || 'Beauty' %></p>
                <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-900 mb-4"><%= product.name %></h1>

                

                <div class="flex items-end gap-4 mb-6 pb-6 border-b border-gray-100">
                    <h2 id="productPrice" class="text-4xl font-bold text-gray-900">₹<%= variants[0].price.toFixed(2) %></h2>
                    <span id="productOriginalPrice" class="text-lg text-gray-400 line-through mb-1 <%= variants[0].appliedOffer ? '' : 'hidden' %>">₹<%= variants[0].originalPrice.toFixed(2) %></span>
                    <span id="productOfferBadge" class="text-sm font-bold text-green-600 bg-green-50 px-2 py-1 rounded mb-1.5 <%= variants[0].appliedOffer ? '' : 'hidden' %>"><%= variants[0].appliedOffer?.label || '' %></span>
                </div>

                <div class="mb-8">
                    <h3 class="text-sm font-bold text-gray-900 mb-3 uppercase tracking-wider">Select Option:</h3>
                    <div class="flex flex-wrap gap-3" id="variantButtonsContainer">
                        <% variants.forEach((variant, index)=> { %>
                            <% let validAttributes=variant.attributes.filter(a=> a.value && a.value.toUpperCase() !== 'N/A');
                            let label = validAttributes.map(a => a.value).join(' - ');
                            if (!label || label.trim() === '') label = variant.sku; %>
                            <button onclick="selectVariant(<%= index %>)" id="variantBtn_<%= index %>" class="variant-btn border-2 px-5 py-2.5 rounded-lg font-medium transition-all duration-200 <%= index === 0 ? 'border-primary bg-primary/5 text-primary' : 'border-gray-200 text-gray-700 hover:border-gray-400' %>">
                                <%= label %>
                            </button>
                        <% }) %>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 mb-8">
                    <button id="addToCartBtn" class="flex-1 bg-gray-900 hover:bg-primary text-white text-lg font-bold py-4 rounded-xl transition flex justify-center items-center gap-2">
                        <span class="material-icons-outlined">shopping_bag</span> Add to Cart
                    </button>
                    <button id="wishlistBtn" class="w-14 h-14 bg-gray-50 hover:bg-red-50 text-gray-600 hover:text-red-500 rounded-xl border border-gray-200 transition flex justify-center items-center shrink-0">
                        <span id="wishlistIcon" class="material-icons-outlined transition-colors duration-300">favorite_border</span>
                    </button>
                </div>

                <div class="bg-pink-50 border border-pink-100 rounded-xl p-4 mb-8 flex items-start gap-3">
                    <span class="material-icons-outlined text-primary mt-0.5">local_offer</span>
                    <div>
                        <h4 class="font-bold text-gray-900 text-sm">Available Offers</h4>
                        <p class="text-xs text-gray-600 mt-1" id="productOfferText">
                            <%= variants[0].appliedOffer ? `Offer applied: ${variants[0].appliedOffer.label}` : 'No active product or category offer right now.' %>
                        </p>
                    </div>
                </div>

                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-3 font-display">Product Description</h3>
                    <div class="prose prose-sm text-gray-600 max-w-none"><%= product.description || "No description provided." %></div>
                </div>
            </div>
        </div>
    </div>

    <% if (relatedProducts.length> 0) { %>
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-100">
            <div class="text-center mb-12">
                <h2 class="font-display text-3xl font-bold text-gray-900 mb-3">You May Also Like</h2>
                <div class="h-1 w-16 bg-primary mx-auto rounded-full"></div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <% relatedProducts.forEach(rel=> { %>
                    <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col group cursor-pointer" onclick="window.location.href='/product/<%= rel.slug %>'">
                        <div class="relative h-64 bg-gray-50 overflow-hidden">
                            <img src="<%= rel.defaultImage || '/images/placeholder.jpg' %>" alt="<%= rel.name %>" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" />
                        </div>
                        <div class="p-4 flex-1 flex flex-col">
                            <h3 class="font-medium text-gray-900 mb-2 line-clamp-1"><%= rel.name %></h3>
                            <div class="mt-auto flex items-center justify-between">
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold text-lg text-gray-900">₹<%= rel.startingPrice.toFixed(2) %></span>
                                        <% if (rel.appliedOffer && rel.originalStartingPrice > rel.startingPrice) { %>
                                            <span class="text-sm text-gray-400 line-through">₹<%= rel.originalStartingPrice.toFixed(2) %></span>
                                        <% } %>
                                    </div>
                                    <% if (rel.appliedOffer) { %>
                                        <span class="text-[10px] text-green-600 font-bold uppercase tracking-wider"><%= rel.appliedOffer.label %></span>
                                    <% } %>
                                </div>
                                <button class="bg-gray-100 group-hover:bg-primary group-hover:text-white text-gray-900 text-xs font-bold px-4 py-2 rounded-full transition uppercase tracking-wider">View</button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>
    <% } %>

</main>

<%- include('../partials/footer') %>

<script>
    const variantsData = <%- locals.variantsJSON || '[]' %>;
    const cartVariantIds = <%- locals.cartVariantIdsJSON || '[]' %>;
    const wishlistProductIds = <%- locals.wishlistProductIdsJSON || '[]' %>;
    const currentProductId = "<%= product._id.toString() %>";

    const mainImage = document.getElementById('mainImage');
    const thumbnailContainer = document.getElementById('thumbnailContainer');
    const productPrice = document.getElementById('productPrice');
    const addToCartBtn = document.getElementById('addToCartBtn');
    const stockBadge = document.getElementById('stockBadge');
    const wishlistBtn = document.getElementById('wishlistBtn');
    const wishlistIcon = document.getElementById('wishlistIcon');

    function updateWishlistBadge(count) {
        const badge = document.getElementById('wishlistBadge');
        if (!badge || typeof count !== 'number') return;

        badge.innerText = count;

        if (count > 0) {
            badge.classList.remove('hidden');
            badge.classList.add('scale-125');
            setTimeout(() => badge.classList.remove('scale-125'), 200);
        } else {
            badge.classList.add('hidden');
        }
    }

    let currentVariantIndex = 0;

    function selectVariant(index) {
        currentVariantIndex = index;
        const variant = variantsData[index];
        if (!variant) return;

        document.querySelectorAll('.variant-btn').forEach((btn, i) => {
            if (i === index) {
                btn.classList.replace('border-gray-200', 'border-primary');
                btn.classList.replace('text-gray-700', 'text-primary');
                btn.classList.add('bg-primary/5');
            } else {
                btn.classList.replace('border-primary', 'border-gray-200');
                btn.classList.replace('text-primary', 'text-gray-700');
                btn.classList.remove('bg-primary/5');
            }
        });

        if (productPrice) productPrice.innerText = `₹${variant.price.toFixed(2)}`;
        const productOriginalPrice = document.getElementById('productOriginalPrice');
        const productOfferBadge = document.getElementById('productOfferBadge');
        const productOfferText = document.getElementById('productOfferText');
        if (productOriginalPrice && productOfferBadge && productOfferText) {
            if (variant.appliedOffer) {
                productOriginalPrice.innerText = `₹${variant.originalPrice.toFixed(2)}`;
                productOriginalPrice.classList.remove('hidden');
                productOfferBadge.innerText = variant.appliedOffer.label;
                productOfferBadge.classList.remove('hidden');
                productOfferText.innerText = `Offer applied: ${variant.appliedOffer.label}`;
            } else {
                productOriginalPrice.classList.add('hidden');
                productOfferBadge.classList.add('hidden');
                productOfferText.innerText = 'No active product or category offer right now.';
            }
        }

        const isInCart = cartVariantIds.includes(variant._id.toString());
        if (variant.stock <= 0) {
            addToCartBtn.disabled = true;
            addToCartBtn.dataset.action = "outOfStock";
            addToCartBtn.innerHTML = '<span class="material-icons-outlined">remove_shopping_cart</span> Out of Stock';
            addToCartBtn.className = "flex-1 bg-gray-300 text-gray-500 cursor-not-allowed text-lg font-bold py-4 rounded-xl transition flex justify-center items-center gap-2";
            if (stockBadge) stockBadge.classList.remove('hidden');
            if (mainImage) mainImage.classList.add('opacity-70', 'grayscale');
        } else if (isInCart) {
            addToCartBtn.disabled = false;
            addToCartBtn.dataset.action = "goToCart";
            addToCartBtn.innerHTML = '<span class="material-icons-outlined">shopping_cart_checkout</span> Go to Cart';
            addToCartBtn.className = "flex-1 bg-primary hover:bg-pink-700 text-white text-lg font-bold py-4 rounded-xl transition flex justify-center items-center gap-2 shadow-lg shadow-primary/30";
            if (stockBadge) stockBadge.classList.add('hidden');
            if (mainImage) mainImage.classList.remove('opacity-70', 'grayscale');
        } else {
            addToCartBtn.disabled = false;
            addToCartBtn.dataset.action = "add";
            addToCartBtn.innerHTML = '<span class="material-icons-outlined">shopping_bag</span> Add to Cart';
            addToCartBtn.className = "flex-1 bg-gray-900 hover:bg-primary text-white text-lg font-bold py-4 rounded-xl transition flex justify-center items-center gap-2";
            if (stockBadge) stockBadge.classList.add('hidden');
            if (mainImage) mainImage.classList.remove('opacity-70', 'grayscale');
        }

        if (wishlistBtn && wishlistIcon) {
            if (wishlistProductIds.includes(currentProductId)) {
                wishlistIcon.innerText = 'favorite';
                wishlistIcon.classList.add('text-red-500');
            } else {
                wishlistIcon.innerText = 'favorite_border';
                wishlistIcon.classList.remove('text-red-500');
            }
        }

        if (mainImage && variant.images && variant.images.length > 0) {
            mainImage.src = variant.images[0];
            if (thumbnailContainer) {
                thumbnailContainer.innerHTML = '';
                variant.images.forEach((imgUrl, imgIndex) => {
                    const thumb = document.createElement('button');
                    thumb.className = `w-20 h-20 rounded-xl overflow-hidden border-2 shrink-0 transition-all ${imgIndex === 0 ? 'border-gray-900' : 'border-transparent hover:border-gray-300'}`;
                    thumb.innerHTML = `<img src="${imgUrl}" class="w-full h-full object-cover">`;
                    thumb.onclick = () => {
                        mainImage.src = imgUrl;
                        Array.from(thumbnailContainer.children).forEach(c => c.classList.replace('border-gray-900', 'border-transparent'));
                        thumb.classList.replace('border-transparent', 'border-gray-900');
                    };
                    thumbnailContainer.appendChild(thumb);
                });
            }
        }
    }

    if (variantsData.length > 0) selectVariant(0);

    function zoomImage(e) {
        const container = e.currentTarget;
        const img = container.querySelector('img');
        if (!variantsData[currentVariantIndex] || variantsData[currentVariantIndex].stock <= 0) return;

        const { left, top, width, height } = container.getBoundingClientRect();
        const x = ((e.clientX - left) / width) * 100;
        const y = ((e.clientY - top) / height) * 100;
        img.style.transformOrigin = `${x}% ${y}%`;
        img.style.transform = 'scale(2)';
    }

    function resetZoom(e) {
        const img = e.currentTarget.querySelector('img');
        img.style.transformOrigin = 'center center';
        img.style.transform = 'scale(1)';
    }

    if (addToCartBtn) {
        addToCartBtn.addEventListener('click', async function () {
            if (this.dataset.action === "goToCart") {
                window.location.href = '/cart';
                return;
            }

            const selectedVariant = variantsData[currentVariantIndex];
            if (!selectedVariant || selectedVariant.stock <= 0) return;

            const originalText = this.innerHTML;
            this.innerHTML = '<span class="material-icons-outlined animate-spin">refresh</span> Adding...';
            this.disabled = true;

            try {
                // RESTful update
                const response = await fetch('/cart/items', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ variantId: selectedVariant._id, quantity: 1 })
                });

                const data = await response.json();
                if (data.success) {
                    cartVariantIds.push(selectedVariant._id.toString());
                    const badge = document.getElementById('cartBadge');
                    if (badge) {
                        badge.innerText = data.cartCount;
                        badge.classList.remove('hidden');
                        badge.classList.add('scale-125');
                        setTimeout(() => badge.classList.remove('scale-125'), 200);
                    }

                    this.dataset.action = "goToCart";
                    this.innerHTML = '<span class="material-icons-outlined">shopping_cart_checkout</span> Go to Cart';
                    this.className = "flex-1 bg-primary hover:bg-pink-700 text-white text-lg font-bold py-4 rounded-xl transition flex justify-center items-center gap-2 shadow-lg shadow-primary/30";
                    this.disabled = false;

                    Swal.fire({ icon: 'success', title: 'Added to Cart!', text: data.message, showConfirmButton: false, timer: 1500, position: 'top-end', toast: true });
                } else {
                    if (data.redirect) {
                        window.location.href = data.redirect;
                        return;
                    }
                    Swal.fire({ icon: 'error', title: 'Cannot Add Item', text: data.message });
                    this.innerHTML = originalText;
                    this.disabled = false;
                }
            } catch (error) {
                Swal.fire('Error', 'Network error. Please try again.', 'error');
                this.innerHTML = originalText;
                this.disabled = false;
            }
        });
    }

    if (wishlistBtn) {
        wishlistBtn.addEventListener('click', async function () {
            const selectedVariant = variantsData[currentVariantIndex];
            if (!selectedVariant) return;

            wishlistIcon.classList.add('scale-125');
            setTimeout(() => wishlistIcon.classList.remove('scale-125'), 200);

            try {
                // RESTful update
                const response = await fetch('/wishlist/items/toggle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ variantId: selectedVariant._id })
                });

                const data = await response.json();

                if (data.success) {
                    const resolvedProductId = data.productId || currentProductId;
                    if (data.isAdded) {
                        if (!wishlistProductIds.includes(resolvedProductId)) {
                            wishlistProductIds.push(resolvedProductId);
                        }
                        updateWishlistBadge(data.wishlistCount);
                        wishlistIcon.innerText = 'favorite';
                        wishlistIcon.classList.add('text-red-500');
                        Swal.fire({ icon: 'success', title: 'Added to Wishlist!', showConfirmButton: false, timer: 1500, toast: true, position: 'top-end' });
                        
                    } else {
                        const index = wishlistProductIds.indexOf(resolvedProductId);
                        if (index > -1) wishlistProductIds.splice(index, 1);
                        updateWishlistBadge(data.wishlistCount);
                        wishlistIcon.innerText = 'favorite_border';
                        wishlistIcon.classList.remove('text-red-500');
                        Swal.fire({ icon: 'info', title: 'Removed from Wishlist', showConfirmButton: false, timer: 1500, toast: true, position: 'top-end' });
                        
                    }
                } else {
                    if (data.redirect) window.location.href = data.redirect;
                    else Swal.fire({ icon: 'error', title: 'Oops...', text: data.message });
                }
            } catch (error) {
                console.error("Wishlist Error:", error);
                Swal.fire('Error', 'Network error. Please try again.', 'error');
            }
        });
    }

    window.addEventListener('pageshow', function (event) {
        if (event.persisted) window.location.reload();
    });
</script>

<% if (isLoggedIn) { %>
    <%- include("../partials/header") %>
        <% } else { %>
            <%- include("../partials/indexHeader") %>
                <% } %>

                    <main>
                        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                            <div class="relative rounded-3xl overflow-hidden h-[500px] group shadow-2xl">
                                <img alt="Woman with glowing skin"
                                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    src="https://images.unsplash.com/photo-1616683693504-3ea7e9ad6fec?q=80&w=1974&auto=format&fit=crop" />

                                <div
                                    class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent">
                                </div>

                                <div class="absolute bottom-0 left-0 p-8 md:p-16 max-w-2xl text-white">
                                    <span
                                        class="inline-block bg-primary text-white text-xs font-bold uppercase tracking-wider py-1.5 px-3 rounded-md mb-4 shadow-sm">
                                        New Collection
                                    </span>
                                    <h1 class="font-display text-5xl md:text-6xl font-bold mb-4 leading-tight">
                                        Glow Up Season <br /> Is Here
                                    </h1>
                                    <p class="text-gray-200 text-lg md:text-xl font-light max-w-lg mb-8">
                                        Discover our latest collection of summer essentials and shine all season long
                                        with natural radiance.
                                    </p>
                                    <button onclick="window.location.href='/shop'"
                                        class="bg-white text-gray-900 hover:bg-gray-100 px-8 py-3 rounded-full font-medium transition flex items-center gap-2 group/btn">
                                        Shop Now
                                        <span
                                            class="material-icons-outlined text-sm transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
                                    </button>
                                </div>
                            </div>
                        </section>

                        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
                            <div class="text-center mb-12">
                                <h2 class="font-display text-4xl font-bold text-gray-900 dark:text-white mb-3">Shop by
                                    Category</h2>
                                <div class="h-1 w-20 bg-primary mx-auto rounded-full"></div>
                            </div>

                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 justify-items-center">
                                <% if (categories && categories.length> 0) { %>
                                    <% categories.forEach(category=> { %>
                                        <div class="flex flex-col items-center group cursor-pointer w-full max-w-[160px]"
                                            onclick="window.location.href='/shop?category=<%= category._id %>'">
                                            <div
                                                class="w-32 h-32 md:w-40 md:h-40 rounded-full overflow-hidden mb-4 border-4 border-transparent group-hover:border-primary/20 transition-all duration-300 shadow-lg">
                                                <img alt="<%= category.name %>"
                                                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                                    src="<%= category.categoryImage || '/images/placeholder.jpg' %>" />
                                            </div>
                                            <h3
                                                class="text-lg text-center font-medium text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                                                <%= category.name %>
                                            </h3>
                                        </div>
                                        <% }) %>
                                            <% } else { %>
                                                <p class="col-span-full text-center text-gray-500">No categories found.
                                                </p>
                                                <% } %>
                            </div>
                        </section>

                        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
                            <div class="text-center mb-12">
                                <h2 class="font-display text-4xl font-bold text-gray-900 dark:text-white mb-3">Featured
                                    For You</h2>
                                <div class="h-1 w-20 bg-primary mx-auto rounded-full"></div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                                <% if (featuredProducts && featuredProducts.length> 0) { %>
                                    <% featuredProducts.forEach((product, index)=> { %>
                                        <div class="bg-card-light dark:bg-card-dark rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-800 flex flex-col group cursor-pointer"
                                            onclick="window.location.href='/product/<%= product.slug %>'">

                                            <div class="relative h-64 bg-gray-50 dark:bg-gray-800 overflow-hidden">
                                                <% if (index===0) { %>
                                                    <span
                                                        class="absolute top-3 left-3 bg-purple-600 text-white text-[10px] font-bold uppercase px-2 py-1 rounded z-10">Bestseller</span>
                                                    <% } else if (index===2) { %>
                                                        <span
                                                            class="absolute top-3 left-3 bg-gray-900 text-white text-[10px] font-bold uppercase px-2 py-1 rounded z-10">New</span>
                                                        <% } %>

                                                            <img alt="<%= product.name %>"
                                                                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                                                                src="<%= product.defaultImage || '/images/placeholder.jpg' %>" />
                                            </div>

                                            <div class="p-4 flex-1 flex flex-col">
                                                <p
                                                    class="text-xs text-text-muted-light dark:text-text-muted-dark uppercase tracking-wide mb-1">
                                                    <%= product.brand %>
                                                </p>
                                                <h3
                                                    class="font-medium text-gray-900 dark:text-white mb-2 line-clamp-2 min-h-[3rem]">
                                                    <%= product.name %>
                                                </h3>
                                                <div class="mt-auto flex items-center justify-between">
                                                    <span class="font-bold text-lg text-gray-900 dark:text-white">₹<%=
                                                            product.startingPrice.toFixed(2) %></span>
                                                    <button
                                                        class="bg-primary hover:bg-pink-700 text-white text-xs font-bold px-4 py-2 rounded-full transition uppercase tracking-wider">
                                                        View
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                            <% } else { %>
                                                <p class="col-span-4 text-center text-gray-500">No products available at
                                                    the moment.</p>
                                                <% } %>
                            </div>
                        </section>
                    </main>

                    <%- include('../partials/footer') %>
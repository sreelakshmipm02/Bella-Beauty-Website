<%- include('../partials/header', { title: 'My Wallet' }) %>
    <%- include('../partials/userSideNavbar') %>

        <div class="flex-1 space-y-6">
            <% const walletTransactions = (user.wallet?.transactions || []).slice(0, 20); %>

            <div class="bg-white dark:bg-slate-900 rounded-3xl p-8 border border-slate-100 dark:border-slate-800 shadow-sm">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                    <div>
                        <h1 class="font-display text-3xl font-bold mb-1">My Wallet</h1>
                    </div>

                    <div class="rounded-3xl bg-emerald-50 border border-emerald-100 px-6 py-5 min-w-[260px]">
                        <p class="text-[11px] uppercase tracking-[0.25em] font-bold text-emerald-700 mb-2">Available Balance</p>
                        <p class="text-4xl font-bold text-emerald-800">₹<%= Number(user.wallet?.balance || 0).toFixed(2) %></p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between gap-4">
                    <div>
                        <h2 class="font-display text-2xl font-bold">Wallet Activity</h2>
                        <p class="text-slate-500 dark:text-slate-400 text-sm">Most recent transactions first.</p>
                    </div>
                    <div class="rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-600">
                        <%= walletTransactions.length %> entries
                    </div>
                </div>

                <% if (!walletTransactions.length) { %>
                    <div class="p-10 text-center">
                        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 text-slate-400 mb-4">
                            <span class="material-symbols-outlined text-3xl">account_balance_wallet</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-1">No wallet activity yet</h3>
                        <p class="text-sm text-slate-500">Once you pay with the wallet or receive a refund, it will appear here.</p>
                    </div>
                <% } else { %>
                    <div class="divide-y divide-slate-100 dark:divide-slate-800">
                        <% walletTransactions.forEach((tx) => { %>
                            <div class="p-6 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="inline-flex items-center rounded-full px-3 py-1 text-[10px] font-bold uppercase tracking-wider <%= tx.type === 'credit' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-700' %>">
                                            <%= tx.type %>
                                        </span>
                                        <p class="font-semibold text-slate-900"><%= tx.description %></p>
                                    </div>
                                    <p class="text-sm text-slate-500 mt-2">
                                        <%= new Date(tx.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                        <% if (tx.reference) { %>
                                            • Ref: <span class="font-medium text-slate-600"><%= tx.reference %></span>
                                        <% } %>
                                    </p>
                                </div>

                                <div class="text-left md:text-right">
                                    <p class="text-xl font-bold <%= tx.type === 'credit' ? 'text-emerald-700' : 'text-slate-900' %>">
                                        <%= tx.type === 'credit' ? '+' : '-' %>₹<%= Number(tx.amount || 0).toFixed(2) %>
                                    </p>
                                    <p class="text-sm text-slate-500">Balance after: ₹<%= Number(tx.balanceAfter || 0).toFixed(2) %></p>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
        </div>
        </main>

        <%- include('../partials/footer') %>

<%- include("../partials/header") %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 min-h-screen">

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 border-b border-gray-200 pb-6">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <a href="/orders" class="text-gray-500 hover:text-primary transition flex items-center">
                        <span class="material-icons-outlined">arrow_back</span>
                    </a>
                    <h1 class="text-3xl font-bold font-display text-gray-900">Order Details</h1>
                </div>
                <p class="text-sm text-gray-500 ml-9">
                    Order ID: <span class="font-bold text-gray-900">
                        <%= order.orderId %>
                    </span> • Placed on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </p>
            </div>

            <div class="flex items-center gap-3 ml-9 md:ml-0">
                <% if (order.orderStatus === 'Delivered') { %>
                    <button onclick="downloadInvoice('<%= order._id %>')"
                        class="bg-gray-100 hover:bg-gray-200 text-gray-900 font-bold py-2 px-4 rounded-lg transition flex items-center gap-2 text-sm">
                        <span class="material-icons-outlined text-sm">download</span> Invoice
                    </button>
                <% } else { %>
                    <span class="text-xs text-gray-400 italic">Invoice available after delivery</span>
                <% } %>

                <% let statusColor='bg-yellow-100 text-yellow-800 border-yellow-200' ;
                if (order.orderStatus==='Delivered' ) statusColor='bg-green-100 text-green-800 border-green-200' ;
                if (order.orderStatus==='Cancelled' || order.orderStatus==='Returned' ) statusColor='bg-red-100 text-red-800 border-red-200' ;
                if (order.orderStatus==='Shipped' ) statusColor='bg-blue-100 text-blue-800 border-blue-200' ;
                %>
                    <span class="px-4 py-2 rounded-lg font-bold text-sm border <%= statusColor %>">
                        <%= order.orderStatus %>
                    </span>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-8">

            <div class="flex-1 space-y-6">
                <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
                    <h2 class="text-xl font-bold text-gray-900 mb-6">Items in this Order</h2>

                    <div class="space-y-6">
                        <% order.items.forEach(item=> { %>
                            <div class="flex flex-col sm:flex-row gap-6 border-b border-gray-100 pb-6 last:border-0 last:pb-0">
                                <div class="w-24 h-24 rounded-xl bg-gray-50 border border-gray-100 overflow-hidden shrink-0">
                                    <img src="<%= item.image %>" class="w-full h-full object-cover">
                                </div>

                                <div class="flex-1">
                                    <h3 class="font-bold text-gray-900 line-clamp-2 mb-1"><%= item.productName %></h3>
                                    <p class="text-sm text-gray-500 mb-2">Qty: <%= item.quantity %> × ₹<%= item.price %></p>

                                    <% let itemStatusColor='text-yellow-600 bg-yellow-50' ; 
                                       if (item.status==='Delivered' ) itemStatusColor='text-green-600 bg-green-50' ;
                                       if (item.status==='Cancelled' || item.status==='Returned' ) itemStatusColor='text-red-600 bg-red-50' ;
                                    %>
                                        <span class="inline-block px-2 py-1 rounded text-xs font-bold <%= itemStatusColor %>"><%= item.status %></span>
                                </div>

                                <div class="text-left sm:text-right flex flex-col justify-between">
                                    <p class="font-bold text-lg text-gray-900">₹<%= item.itemTotal %></p>

                                    <% if ((order.orderStatus==='Pending' || order.orderStatus==='Processing' ) && item.status !=='Cancelled' ) { %>
                                        <button onclick="cancelItem('<%= order._id %>', '<%= item._id %>')"
                                            class="text-sm text-red-500 hover:text-red-700 font-medium transition mt-2">
                                            Cancel Item
                                        </button>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <div class="w-full lg:w-1/3 space-y-6">

                <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 shadow-sm">
                    <div class="mb-6">
                        <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3">Shipping Address</h3>
                        <p class="font-bold text-gray-900"><%= order.shippingAddress.fullName %></p>
                        <p class="text-sm text-gray-600 mt-1"><%= order.shippingAddress.addressLine1 %></p>
                        <% if (order.shippingAddress.addressLine2) { %>
                            <p class="text-sm text-gray-600"><%= order.shippingAddress.addressLine2 %></p>
                        <% } %>
                        <p class="text-sm text-gray-600"><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.postalCode %></p>
                        <p class="text-sm text-gray-600 mt-2">Phone: <%= order.shippingAddress.phone %></p>
                    </div>

                    <div class="border-t border-gray-200 pt-6">
                        <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3">Payment Method</h3>
                        <div class="flex justify-between items-center">
                            <p class="font-bold text-gray-900"><%= order.payment.method %></p>
                            <span class="px-2 py-1 rounded text-xs font-bold <%= order.payment.status === 'Paid' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                <%= order.payment.status %>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 shadow-sm">
                    <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Price Summary</h3>
                    <div class="space-y-3 text-sm text-gray-600 border-b border-gray-200 pb-4 mb-4">
                        <div class="flex justify-between">
                            <span>Subtotal</span>
                            <span class="font-medium text-gray-900">₹<%= order.summary.subtotal %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Tax (GST)</span>
                            <span class="font-medium text-gray-900">₹<%= order.summary.tax %></span>
                        </div>
                        <div class="flex justify-between text-green-600">
                            <span>Delivery</span>
                            <span class="font-medium">Free</span>
                        </div>
                        <% if (order.summary.discount> 0) { %>
                            <div class="flex justify-between text-green-600">
                                <span>Discount</span>
                                <span class="font-medium">- ₹<%= order.summary.discount %></span>
                            </div>
                        <% } %>
                    </div>
                    <div class="flex justify-between items-end mb-6">
                        <span class="font-bold text-gray-900">Total</span>
                        <span class="text-2xl font-bold text-primary">₹<%= order.summary.total %></span>
                    </div>

                    <% if (order.orderStatus==='Pending' || order.orderStatus==='Processing' ) { %>
                        <button onclick="cancelWholeOrder('<%= order._id %>')"
                            class="w-full bg-white border-2 border-red-500 text-red-500 hover:bg-red-50 font-bold py-4 rounded-xl transition flex justify-center items-center gap-2">
                            <span class="material-icons-outlined">cancel</span> Cancel Entire Order
                        </button>
                    <% } else if (order.orderStatus==='Delivered' ) { %>
                        <button onclick="returnOrder('<%= order._id %>')"
                            class="w-full bg-white border-2 border-orange-500 text-orange-500 hover:bg-orange-50 font-bold py-4 rounded-xl transition flex justify-center items-center gap-2">
                            <span class="material-icons-outlined">keyboard_return</span> Request Return
                        </button>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <script>
        function downloadInvoice(orderId) {
            Swal.fire({ icon: 'info', title: 'Coming Soon!', text: 'Invoice generation will be added in Phase 3.' });
        }

        const cancelReasons = [
            "Order created by mistake",
            "Item(s) would not arrive on time",
            "Shipping cost too high",
            "Found cheaper somewhere else",
            "Changed my mind"
        ];
        const returnReasons = [
            "Product damaged or defective",
            "Received wrong item",
            "Item does not match description",
            "Missing parts or accessories",
            "Quality is not as expected"
        ];

        async function promptWithReasonOptions(title, text, options, confirmText, confirmColor) {
            let optionsHtml = options.map(opt => `<option value="${opt}">${opt}</option>`).join('');
            optionsHtml += `<option value="Others">Others (Please specify)</option>`;

            return await Swal.fire({
                title: title,
                text: text,
                icon: 'warning',
                html: `
                <div class="mt-4 text-left">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Select Reason:</label>
                    <select id="reasonSelect" class="w-full p-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-primary focus:border-primary transition mb-3 text-sm">
                        <option value="" disabled selected>Choose a reason...</option>
                        ${optionsHtml}
                    </select>
                    <textarea id="customReason" class="w-full p-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-primary focus:border-primary transition hidden text-sm" rows="3" placeholder="Please tell us more..."></textarea>
                </div>
            `,
                showCancelButton: true,
                confirmButtonColor: confirmColor,
                confirmButtonText: confirmText,
                didOpen: () => {
                    const select = document.getElementById('reasonSelect');
                    const customInput = document.getElementById('customReason');
                    select.addEventListener('change', (e) => {
                        if (e.target.value === 'Others') {
                            customInput.classList.remove('hidden');
                            customInput.focus();
                        } else {
                            customInput.classList.add('hidden');
                        }
                    });
                },
                preConfirm: () => {
                    const select = document.getElementById('reasonSelect');
                    const customInput = document.getElementById('customReason');

                    if (!select.value) {
                        Swal.showValidationMessage('Please select a reason from the dropdown.');
                        return false;
                    }
                    if (select.value === 'Others') {
                        if (!customInput.value.trim()) {
                            Swal.showValidationMessage('Please type your custom reason.');
                            return false;
                        }
                        return customInput.value.trim();
                    }
                    return select.value;
                }
            });
        }

        async function cancelWholeOrder(orderId) {
            const { value: reason, isConfirmed } = await promptWithReasonOptions(
                'Cancel Order?',
                'Are you sure you want to cancel this entire order?',
                cancelReasons,
                'Yes, Cancel Order',
                '#e11d48'
            );
            if (isConfirmed) processAction(`/orders/${orderId}/cancel`, { reason });
        }

        async function cancelItem(orderId, itemId) {
            const { value: reason, isConfirmed } = await promptWithReasonOptions(
                'Cancel Item?',
                'Are you sure you want to remove this item from your order?',
                cancelReasons,
                'Yes, Cancel Item',
                '#e11d48'
            );
            // RESTful update
            if (isConfirmed) processAction(`/orders/${orderId}/items/${itemId}/cancel`, { reason });
        }

        async function returnOrder(orderId) {
            const { value: reason, isConfirmed } = await promptWithReasonOptions(
                'Request Return',
                'Please let us know why you are returning this order.',
                returnReasons,
                'Submit Return',
                '#f97316'
            );
            if (isConfirmed) processAction(`/orders/${orderId}/return`, { reason });
        }

        async function processAction(url, bodyData) {
            try {
                Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(bodyData)
                });
                const data = await response.json();

                if (data.success) {
                    await Swal.fire({ icon: 'success', title: 'Success!', text: data.message, timer: 1500, showConfirmButton: false });
                    window.location.reload();
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Network error. Please try again.', 'error');
            }
        }
    </script>

    <%- include("../partials/footer") %>
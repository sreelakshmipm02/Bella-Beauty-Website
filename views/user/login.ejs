<%- include('../partials/indexHeader', { title: 'Bella Beauty' }) %>
    <main class="flex-grow flex items-center justify-center p-6 md:p-12">
        <div
            class="max-w-6xl w-full bg-white dark:bg-slate-900 rounded-3xl overflow-hidden flex flex-col md:flex-row shadow-2xl shadow-slate-200 dark:shadow-none min-h-[700px]">
            <div class="md:w-1/2 relative main-gradient p-12 flex flex-col justify-end overflow-hidden">
                <img alt="Login Visual"
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBhZZtH0q636bJJ7nHajiLQCyoBSoVZxQjLYZZPwoEHPAJBT0li9YfJDjcEu_3JxTsfWOx7kmRVhcMFIbgP9OJSXxfUBHPDuI1b1OEr0AUugqZhDMEywIRfkT43s-fFqxJrYwgdCReEAdXToIoR9erpXF_cKpo_mGnbWqfazWd0DxP1T10_iahjR1Yc3SbVhd7u_3xW6uJ7y_Zk_28wBP7THOVn4Hsl--Poto1TRgutKiPwSMwb6FCZgCZ3HufzfyxjUf9vjbUWbg" />
                <div class="absolute inset-0 bg-gradient-to-t from-primary/80 to-transparent"></div>
                <div class="relative z-10 text-white">
                    <span
                        class="inline-block px-4 py-1.5 bg-white/20 backdrop-blur-md rounded-lg text-xs font-bold uppercase tracking-widest mb-6 border border-white/30">
                        Member Exclusive
                    </span>
                    <h1 class="font-display text-6xl leading-tight mb-4">Glow With Confidence</h1>
                    <p class="text-white/90 text-lg max-w-md leading-relaxed">
                        Sign in to access your personalized beauty profile, track orders, and explore exclusive offers.
                    </p>
                </div>
            </div>
            <div class="md:w-1/2 p-8 md:p-16 flex flex-col justify-center">
                <div class="max-w-md mx-auto w-full">
                    <h2 class="font-display text-4xl mb-2 text-slate-800 dark:text-white">Welcome Back</h2>
                    <p class="text-slate-500 dark:text-slate-400 mb-10">Please enter your details to sign in.</p>
                    <form class="space-y-6" method="POST" action="/login">

                        <% if (error) { %>
                            <div class="bg-red-100 text-red-700 p-3 rounded-xl text-sm">
                                <%= error %>
                            </div>
                            <% } %>

                                <!-- Email or Username -->
                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                                        Email or Username
                                    </label>

                                    <div class="relative">
                                        <span
                                            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xl">
                                            person
                                        </span>

                                        <input name="identifier" type="text" required placeholder="email or username"
                                            class="w-full bg-slate-50 dark:bg-slate-800 border-slate-200 dark:border-slate-700 rounded-xl py-4 pl-12 pr-4 focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none" />
                                    </div>
                                </div>


                                <!-- Password -->
                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                                        Password
                                    </label>

                                    <div class="relative">
                                        <span
                                            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xl">
                                            lock
                                        </span>

                                        <input name="password" type="password" required placeholder="••••••••"
                                            class="w-full bg-slate-50 dark:bg-slate-800 border-slate-200 dark:border-slate-700 rounded-xl py-4 pl-12 pr-4 focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none" />
                                    </div>
                                </div>

                                <!-- Remember + Forgot -->
                                <div class="flex items-center justify-between text-sm">

                                    <a class="text-primary font-semibold hover:underline" href="/forgot-password">
                                        Forgot password?
                                    </a>
                                </div>

                                <!-- Submit -->
                                <button
                                    class="w-full bg-primary hover:bg-opacity-90 text-white py-4 rounded-xl font-bold flex items-center justify-center gap-2 transition-all transform hover:scale-[1.01] active:scale-[0.98] shadow-lg shadow-pink-100 dark:shadow-none"
                                    type="submit">
                                    Login
                                    <span
                                        class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">
                                        arrow_forward
                                    </span>
                                </button>

                    </form>

                    <div class="relative my-10 text-center">
                        <hr class="border-slate-100 dark:border-slate-800" />
                        <span
                            class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white dark:bg-slate-900 px-4 text-sm text-slate-400">Or
                            sign in with</span>
                    </div>
                    <div class="flex justify-center  mt-6">
                        <a href="/auth/google"
                            class="flex items-center justify-center gap-3 py-3 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors font-medium w-full">
                            <img src="https://developers.google.com/identity/images/g-logo.png" class="w-5 h-5" />
                            Google
                        </a>
                    </div>
                    <p class="text-center mt-10 text-slate-600 dark:text-slate-400">
                        Don't have an account? <a class="text-primary font-bold hover:underline" href="/signup">Sign up
                            now</a>
                    </p>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
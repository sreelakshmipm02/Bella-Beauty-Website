<%- include('../partials/indexHeader', { title: 'Bella Beauty' }) %>
    <main class="flex-grow flex items-center justify-center p-6 md:p-12">
        <div class="max-w-6xl w-full bg-white dark:bg-slate-900 rounded-3xl overflow-hidden flex flex-col md:flex-row shadow-2xl shadow-slate-200 dark:shadow-none min-h-[700px]">
            
            <div class="md:w-1/2 relative main-gradient p-12 flex flex-col justify-end overflow-hidden">
                <img alt="Login Visual"
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBhZZtH0q636bJJ7nHajiLQCyoBSoVZxQjLYZZPwoEHPAJBT0li9YfJDjcEu_3JxTsfWOx7kmRVhcMFIbgP9OJSXxfUBHPDuI1b1OEr0AUugqZhDMEywIRfkT43s-fFqxJrYwgdCReEAdXToIoR9erpXF_cKpo_mGnbWqfazWd0DxP1T10_iahjR1Yc3SbVhd7u_3xW6uJ7y_Zk_28wBP7THOVn4Hsl--Poto1TRgutKiPwSMwb6FCZgCZ3HufzfyxjUf9vjbUWbg" />
                <div class="absolute inset-0 bg-gradient-to-t from-primary/80 to-transparent"></div>
                <div class="relative z-10 text-white">
                    <span class="inline-block px-4 py-1.5 bg-white/20 backdrop-blur-md rounded-lg text-xs font-bold uppercase tracking-widest mb-6 border border-white/30">
                        Member Exclusive
                    </span>
                    <h1 class="font-display text-6xl leading-tight mb-4">Glow With Confidence</h1>
                    <p class="text-white/90 text-lg max-w-md leading-relaxed">
                        Sign in to access your personalized beauty profile, track orders, and explore exclusive offers.
                    </p>
                </div>
            </div>

            <div class="md:w-1/2 p-8 md:p-16 flex flex-col justify-center">
                <div class="max-w-md mx-auto w-full">
                    <h2 class="font-display text-4xl mb-2 text-slate-800 dark:text-white">
                        <%= isSuspended ? 'Account Access Update' : 'Welcome Back' %>
                    </h2>
                    <p class="text-slate-500 dark:text-slate-400 mb-10">
                        <%= isSuspended
                            ? 'This account cannot sign in right now. The next steps are below.'
                            : 'Please enter your details to sign in.' %>
                    </p>
                    
                    <form id="loginForm" class="space-y-6" method="POST" action="/login">

                        <% if (message) { %>
                            <div class="bg-green-100 text-green-700 p-3 rounded-xl text-sm">
                                <%= message %>
                            </div>
                        <% } %>

                        <% if (isSuspended) { %>
                            <div class="rounded-3xl border border-amber-200 bg-gradient-to-br from-amber-50 via-white to-rose-50 p-6 shadow-sm">
                                <div class="flex items-start gap-4">
                                    <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
                                        <span class="material-symbols-outlined text-2xl">gpp_maybe</span>
                                    </div>

                                    <div>
                                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-700">
                                            Account Status
                                        </p>
                                        <h3 class="font-display text-2xl text-slate-900 mt-2">
                                            This account has been suspended
                                        </h3>
                                        <p id="loginErrorMessage" class="text-sm text-slate-600 leading-relaxed mt-2">
                                            <%= error %>
                                        </p>
                                        <p class="text-sm text-slate-500 leading-relaxed mt-2">
                                            Continue with a different account below.
                                        </p>

                                        <div class="mt-5">
                                            <a href="<%= googleAuthUrl %>"
                                                class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-2xl border border-slate-200 text-slate-700 font-semibold hover:bg-white transition-colors">
                                                <span class="material-symbols-outlined text-lg">switch_account</span>
                                                Use Another Google Account
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } else if (error) { %>
                            <div id="loginErrorMessage" class="bg-red-100 text-red-700 p-3 rounded-xl text-sm">
                                <%= error %>
                            </div>
                        <% } %>

                        <div>
                            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                                Email or Username
                            </label>

                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xl">
                                    person
                                </span>

                                <input id="identifier" name="identifier" type="text" placeholder="email or username"
                                    class="w-full bg-slate-50 dark:bg-slate-800 border-slate-200 dark:border-slate-700 rounded-xl py-4 pl-12 pr-4 focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none" />
                            </div>
                            <p id="identifierError" class="text-red-500 text-xs mt-1 ml-1 hidden"></p>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                                Password
                            </label>

                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xl">
                                    lock
                                </span>

                                <input id="password" name="password" type="password" placeholder="••••••••"
                                    class="w-full bg-slate-50 dark:bg-slate-800 border-slate-200 dark:border-slate-700 rounded-xl py-4 pl-12 pr-12 focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none" />
                                
                                <button type="button" onclick="togglePassword()" 
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary transition-colors cursor-pointer outline-none">
                                    <span id="eyeIcon" class="material-symbols-outlined text-xl">visibility_off</span>
                                </button>
                            </div>
                            <p id="passwordError" class="text-red-500 text-xs mt-1 ml-1 hidden"></p>
                        </div>

                        <div class="flex items-center justify-end text-sm">
                            <a class="text-primary font-semibold hover:underline" href="/forgot-password">
                                Forgot password?
                            </a>
                        </div>

                        <button id="submitBtn" disabled
                            class="w-full bg-primary hover:bg-opacity-90 disabled:bg-gray-300 disabled:cursor-not-allowed text-white py-4 rounded-xl font-bold flex items-center justify-center gap-2 transition-all transform hover:scale-[1.01] active:scale-[0.98] shadow-lg shadow-pink-100 dark:shadow-none"
                            type="submit">
                            Login
                            <span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">
                                arrow_forward
                            </span>
                        </button>

                    </form>

                    <div class="relative my-10 text-center">
                        <hr class="border-slate-100 dark:border-slate-800" />
                        <span class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white dark:bg-slate-900 px-4 text-sm text-slate-400">
                            Or sign in with
                        </span>
                    </div>
                    <div class="flex justify-center mt-6">
                        <a href="<%= googleAuthUrl %>"
                            class="flex items-center justify-center gap-3 py-3 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors font-medium w-full">
                            <img src="https://developers.google.com/identity/images/g-logo.png" class="w-5 h-5" />
                            <%= isSuspended ? 'Choose a Google Account' : 'Continue with Google' %>
                        </a>
                    </div>
                    <p class="text-center mt-10 text-slate-600 dark:text-slate-400">
                        Don't have an account? <a class="text-primary font-bold hover:underline" href="/signup">Sign up now</a>
                    </p>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/userLogin.js"></script>

    <%- include('../partials/footer') %>

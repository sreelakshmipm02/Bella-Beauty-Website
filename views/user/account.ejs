<%- include('../partials/header', { title: 'Bella Beauty' }) %>
    <%- include('../partials/userSideNavbar') %>
        <div class="tab-content flex-1 space-y-1" id="account">
            <header class="flex flex-col md:flex-row md:items-center justify-between gap-2">
                <div>
                    <h1 class="font-display text-3xl font-bold mb-1">My Account</h1>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        Welcome back, <%= user.firstName %>!
                    </p>
                </div>
                <button onclick='openEditProfileModal()'
                    class="nav-link hover:bg-primary/90 text-black px-6 py-2 rounded-full text-xs font-semibold shadow-md flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">edit</span>
                    Edit
                </button>
            </header>

            <div
                class="bg-white dark:bg-slate-800 rounded-xl border border-pink-50 dark:border-slate-700/50 overflow-hidden">

                <div class="p-5 md:p-6 flex items-center gap-4 border-b border-slate-100 dark:border-slate-700/50">
                    <div
                        class="w-16 h-16 rounded-full bg-pink-100 flex items-center justify-center overflow-hidden border border-pink-200">
                        <% if (user.profileImage) { %>
                            <img src="<%= user.profileImage %>" alt="Profile" class="w-full h-full object-cover">
                            <% } else { %>
                                <span class="text-primary text-xl font-semibold">
                                    <%= (user.firstName?.charAt(0) || '' ) + (user.lastName?.charAt(0) || '' ) %>
                                </span>
                                <% } %>
                    </div>
                    <div>
                        <h4 class="font-medium">Profile Picture</h4>
                    </div>
                </div>

                <div class="divide-y divide-slate-100 dark:divide-slate-700/50">
                    <div class="p-5 md:p-6">
                        <p class="text-[10px] uppercase tracking-widest font-bold text-slate-400">Username</p>
                        <p class="font-medium">
                            <%= user.userName %>
                        </p>
                    </div>

                    <div class="p-5 md:p-6">
                        <p class="text-[10px] uppercase tracking-widest font-bold text-slate-400">Email</p>
                        <p class="font-medium">
                            <%= user.email %>
                        </p>
                    </div>

                    <div class="p-5 md:p-6">
                        <p class="text-[10px] uppercase tracking-widest font-bold text-slate-400">Mobile</p>
                        <p class="font-medium">
                            <%= user.phone %>
                        </p>
                    </div>

                    <div class="p-5 md:p-6">
                        <p class="text-[10px] uppercase tracking-widest font-bold text-slate-400">Referral Code</p>
                        <div class="mt-2 rounded-2xl border border-pink-100 bg-pink-50/60 p-4">
                            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                                <div>
                                    <p id="referralCodeValue" class="font-mono text-lg font-bold tracking-[0.2em] text-primary"><%= user.referralCode %></p>
                                    <p class="text-sm text-slate-500 mt-1">Share this code with friends and let them use it while signing up.</p>
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" onclick="copyReferralCode()" class="rounded-full bg-white px-4 py-2 text-xs font-semibold text-slate-700 border border-slate-200 hover:border-primary hover:text-primary transition">
                                        Copy Code
                                    </button>
                                    <button type="button" onclick="shareReferralCode()" class="rounded-full bg-primary px-4 py-2 text-xs font-semibold text-white hover:bg-pink-700 transition">
                                        Share Code
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
        </main>
        <%- include('../partials/userModals/editProfileModal') %>
            <%- include('../partials/footer') %>
                <script src='/js/editProfile.js'></script>
                <script>
                    function getReferralCodeText() {
                        const code = document.getElementById('referralCodeValue')?.innerText?.trim() || '';
                        return `Join Bella Beauty with my referral code: ${code}`;
                    }

                    async function copyReferralCode() {
                        const code = document.getElementById('referralCodeValue')?.innerText?.trim() || '';
                        if (!code) return;

                        try {
                            await navigator.clipboard.writeText(code);
                            Swal.fire({
                                icon: 'success',
                                title: 'Copied',
                                text: 'Referral code copied successfully.',
                                confirmButtonColor: '#db2777'
                            });
                        } catch (error) {
                            Swal.fire('Error', 'Unable to copy the referral code.', 'error');
                        }
                    }

                    async function shareReferralCode() {
                        const message = getReferralCodeText();

                        try {
                            if (navigator.share) {
                                await navigator.share({
                                    title: 'Bella Beauty Referral Code',
                                    text: message
                                });
                                return;
                            }

                            await navigator.clipboard.writeText(message);
                            Swal.fire({
                                icon: 'success',
                                title: 'Ready to Share',
                                text: 'Referral message copied. You can now paste it anywhere.',
                                confirmButtonColor: '#db2777'
                            });
                        } catch (error) {
                            Swal.fire('Error', 'Unable to share the referral code right now.', 'error');
                        }
                    }
                </script>

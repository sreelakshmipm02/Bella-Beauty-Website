<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    class="min-h-screen bg-gradient-to-br from-rose-50 via-white to-slate-100 text-slate-900 flex items-center justify-center px-6"
  >
    <%
      const statusCopy = {
        400: { title: "Check those details", icon: "!" },
        401: { title: "Login needed", icon: "?" },
        403: { title: "Access unavailable", icon: "!" },
        404: { title: "Page not found", icon: "?" },
        409: { title: "Details changed", icon: "!" },
        422: { title: "Please review this", icon: "!" },
        500: { title: "Something went wrong", icon: "!" },
      };
      const copy = statusCopy[statusCode] || statusCopy[500];
    %>
    <main
      class="max-w-xl w-full bg-white/90 border border-white rounded-[2rem] shadow-xl p-10 text-center"
    >
      <div class="mx-auto mb-6 h-20 w-20 rounded-full bg-pink-100 text-pink-600 flex items-center justify-center text-4xl font-black">
        <%= copy.icon %>
      </div>
      <p
        class="text-sm font-semibold uppercase tracking-[0.3em] text-pink-600 mb-4"
      >
        Status <%= statusCode %>
      </p>
      <h1 class="text-3xl font-bold mb-3"><%= copy.title %></h1>
      <p class="text-slate-600 mb-8"><%= message %></p>
      <% if (typeof errorList !== "undefined" && errorList && errorList.length) { %>
        <div class="text-left rounded-2xl bg-rose-50 border border-rose-100 p-4 mb-8">
          <% errorList.forEach((errorItem) => { %>
            <p class="text-sm text-rose-700 mb-1 last:mb-0"><%= errorItem %></p>
          <% }) %>
        </div>
      <% } %>
      <a
        href="/"
        class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-pink-600 text-white font-semibold hover:bg-pink-700 transition-colors"
      >
        Back to Home
      </a>
    </main>
  </body>
</html>

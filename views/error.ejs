<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 flex items-center justify-center px-6">
    <main class="max-w-lg w-full bg-white border border-slate-200 rounded-3xl shadow-sm p-10 text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-pink-600 mb-4"><%= statusCode %> Error</p>
        <h1 class="text-3xl font-bold mb-3">Something went wrong</h1>
        <p class="text-slate-600 mb-8"><%= message %></p>
        <a href="/" class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-pink-600 text-white font-semibold hover:bg-pink-700 transition-colors">
            Back to Home
        </a>
    </main>
</body>
</html>
